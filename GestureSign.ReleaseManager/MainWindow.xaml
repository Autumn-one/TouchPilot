<Window x:Class="GestureSign.ReleaseManager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
        Title="TouchPilot Release Manager"
        Width="860"
        Height="760"
        MinWidth="760"
        MinHeight="660"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource PageBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Padding="24,18"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal">
                <iconPacks:PackIconLucide Width="25"
                                          Height="25"
                                          Margin="0,0,12,0"
                                          VerticalAlignment="Center"
                                          Foreground="{StaticResource AccentBrush}"
                                          Kind="Github" />
                <TextBlock VerticalAlignment="Center"
                           FontSize="20"
                           FontWeight="SemiBold"
                           Text="TouchPilot Release Manager" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="24,20">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="GitHub 仓库" />
                        <TextBox x:Name="RepositoryTextBox" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="源码目录" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBox x:Name="SourceDirectoryTextBox" />
                            <Button Grid.Column="1"
                                    Width="40"
                                    Margin="8,0,0,0"
                                    Padding="0"
                                    ToolTip="选择源码目录"
                                    Click="BrowseSourceButton_Click">
                                <iconPacks:PackIconLucide Width="17" Height="17" Kind="FolderOpen" />
                            </Button>
                        </Grid>
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="1" Margin="0,16,0,0">
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="GitHub 授权密钥" />
                    <PasswordBox x:Name="TokenPasswordBox" />
                    <TextBlock Margin="0,5,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="12"
                               Text="从源码根目录 TouchPilot.ReleaseManager.config.user 读取；需要 Contents: Read and write 权限。" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="180" />
                        <ColumnDefinition Width="18" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="版本" />
                        <TextBox x:Name="VersionTextBox" Text="0.0.1" TextChanged="VersionTextBox_TextChanged" />
                    </StackPanel>
                    <StackPanel Grid.Column="2">
                        <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Release 标题" />
                        <TextBox x:Name="ReleaseTitleTextBox" Text="TouchPilot 0.0.1" />
                    </StackPanel>
                </Grid>

                <StackPanel Grid.Row="3" Margin="0,16,0,0">
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="Release 说明" />
                    <TextBox x:Name="ReleaseNotesTextBox"
                             Height="116"
                             AcceptsReturn="True"
                             TextWrapping="Wrap"
                             VerticalContentAlignment="Top"
                             VerticalScrollBarVisibility="Auto" />
                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                        <CheckBox x:Name="DraftCheckBox" Content="保存为草稿" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Grid.Row="4" Margin="0,18,0,0">
                    <TextBlock Margin="0,0,0,6" FontWeight="SemiBold" Text="发布日志" />
                    <TextBox x:Name="LogTextBox"
                             Height="150"
                             IsReadOnly="True"
                             AcceptsReturn="True"
                             TextWrapping="NoWrap"
                             FontFamily="Cascadia Mono, Consolas"
                             FontSize="12"
                             HorizontalScrollBarVisibility="Auto"
                             VerticalScrollBarVisibility="Auto" />
                </StackPanel>

                <ProgressBar x:Name="PublishProgressBar"
                             Grid.Row="5"
                             Height="4"
                             Margin="0,18,0,0"
                             IsIndeterminate="True"
                             Visibility="Collapsed" />
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2"
                Padding="24,14"
                Background="{StaticResource SurfaceBrush}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0">
            <Grid>
                <TextBlock x:Name="StatusTextBlock"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource MutedBrush}"
                           Text="就绪" />
                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                    <Button x:Name="DeleteReleaseButton"
                            Margin="0,0,10,0"
                            Background="White"
                            BorderBrush="{StaticResource DangerBrush}"
                            Foreground="{StaticResource DangerBrush}"
                            Click="DeleteReleaseButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Width="17"
                                                      Height="17"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Kind="Trash2" />
                            <TextBlock VerticalAlignment="Center"
                                       Foreground="{StaticResource DangerBrush}"
                                       Text="删除 Release" />
                        </StackPanel>
                    </Button>
                    <Button x:Name="PublishButton"
                            Background="{StaticResource AccentBrush}"
                            BorderBrush="{StaticResource AccentBrush}"
                            Foreground="White"
                            Click="PublishButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <iconPacks:PackIconLucide Width="17"
                                                      Height="17"
                                                      Margin="0,0,8,0"
                                                      VerticalAlignment="Center"
                                                      Kind="Upload" />
                            <TextBlock VerticalAlignment="Center" Foreground="White" Text="打包并发布" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
