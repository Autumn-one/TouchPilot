<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro">
    <Style x:Key="V2.Settings.SectionTitle"
           TargetType="TextBlock"
           BasedOn="{StaticResource V2.Text.SectionTitle}">
        <Setter Property="Margin"
                Value="0,4,0,6" />
    </Style>

    <Style x:Key="V2.Settings.Label"
           TargetType="TextBlock"
           BasedOn="{StaticResource V2.Text.Body}">
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="V2.Settings.Row"
           TargetType="Border">
        <Setter Property="MinHeight"
                Value="58" />
        <Setter Property="Padding"
                Value="0,12" />
        <Setter Property="BorderBrush"
                Value="{StaticResource V2.Brush.Divider}" />
        <Setter Property="BorderThickness"
                Value="0,0,0,1" />
    </Style>

    <Style x:Key="V2.Settings.Subsection"
           TargetType="Border">
        <Setter Property="Margin"
                Value="0,12,0,2" />
        <Setter Property="Padding"
                Value="16,14" />
        <Setter Property="Background"
                Value="{StaticResource V2.Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="BorderThickness"
                Value="3,0,0,0" />
    </Style>

    <Style x:Key="V2.Settings.ToggleSwitch"
           TargetType="controls:ToggleSwitch"
           BasedOn="{StaticResource MahApps.Styles.ToggleSwitch}">
        <Setter Property="MinWidth"
                Value="84" />
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.TextMuted}" />
        <Setter Property="ContentDirection"
                Value="RightToLeft" />
        <Setter Property="ContentPadding"
                Value="8,0,0,0" />
        <Setter Property="HorizontalAlignment"
                Value="Right" />
        <Style.Resources>
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.ContainerBackground" Color="Transparent" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.ContainerBackgroundPointerOver" Color="Transparent" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.ContainerBackgroundPressed" Color="Transparent" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.ContainerBackgroundDisabled" Color="Transparent" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOn" Color="{StaticResource V2.Color.Accent}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOnPointerOver" Color="{StaticResource V2.Color.AccentHover}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOnPressed" Color="{StaticResource V2.Color.AccentHover}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOnDisabled" Color="#AFC8C1" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.StrokeOn" Color="{StaticResource V2.Color.Accent}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.StrokeOnPointerOver" Color="{StaticResource V2.Color.AccentHover}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.StrokeOnPressed" Color="{StaticResource V2.Color.AccentHover}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.StrokeOnDisabled" Color="#AFC8C1" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.KnobFillOn" Color="White" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.KnobFillOnPointerOver" Color="White" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.KnobFillOnPressed" Color="White" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.KnobFillOnDisabled" Color="#F3F6F5" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOff" Color="{StaticResource V2.Color.Surface}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOffPointerOver" Color="{StaticResource V2.Color.SurfaceSubtle}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOffPressed" Color="{StaticResource V2.Color.SurfaceSubtle}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.FillOffDisabled" Color="#EFF2F1" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.StrokeOff" Color="#81908B" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.StrokeOffPointerOver" Color="{StaticResource V2.Color.TextMuted}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.StrokeOffPressed" Color="{StaticResource V2.Color.TextMuted}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.StrokeOffDisabled" Color="#C8D0CD" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.KnobFillOff" Color="{StaticResource V2.Color.TextMuted}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.KnobFillOffPointerOver" Color="{StaticResource V2.Color.Text}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.KnobFillOffPressed" Color="{StaticResource V2.Color.Text}" />
            <SolidColorBrush x:Key="MahApps.Brushes.ToggleSwitch.KnobFillOffDisabled" Color="#AEB8B4" />
        </Style.Resources>
    </Style>

    <Style x:Key="V2.Settings.ComboBox"
           TargetType="ComboBox"
           BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="Height" Value="36" />
        <Setter Property="MinWidth" Value="220" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{StaticResource V2.Brush.Surface}" />
        <Setter Property="BorderBrush" Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="Foreground" Value="{StaticResource V2.Brush.Text}" />
        <Setter Property="FontFamily" Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <Style x:Key="V2.Settings.SegmentedTabItem"
           TargetType="TabItem">
        <Setter Property="MinWidth"
                Value="118" />
        <Setter Property="Height"
                Value="36" />
        <Setter Property="Margin"
                Value="1" />
        <Setter Property="Padding"
                Value="14,0" />
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize"
                Value="13" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.TextMuted}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="TabBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="3">
                        <ContentPresenter HorizontalAlignment="Center"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          ContentSource="Header"
                                          RecognizesAccessKey="True"
                                          TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="TabBorder"
                                    Property="Background"
                                    Value="{StaticResource V2.Brush.AccentSoft}" />
                            <Setter Property="Foreground"
                                    Value="{StaticResource V2.Brush.Text}" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="TabBorder"
                                    Property="Background"
                                    Value="{StaticResource V2.Brush.Accent}" />
                            <Setter TargetName="TabBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource V2.Brush.Accent}" />
                            <Setter Property="Foreground"
                                    Value="White" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="TabBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource V2.Brush.AccentHover}" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="TabBorder"
                                    Property="Opacity"
                                    Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="V2.Settings.SegmentedTabControl"
           TargetType="TabControl">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Top" />
        <Setter Property="ItemContainerStyle"
                Value="{StaticResource V2.Settings.SegmentedTabItem}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{TemplateBinding Background}"
                          KeyboardNavigation.TabNavigation="Local">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Border HorizontalAlignment="Left"
                                Padding="3"
                                Background="{StaticResource V2.Brush.SurfaceSubtle}"
                                BorderBrush="{StaticResource V2.Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="{StaticResource V2.Corner.Small}">
                            <TabPanel IsItemsHost="True" />
                        </Border>
                        <ContentPresenter x:Name="PART_SelectedContentHost"
                                          Grid.Row="1"
                                          Margin="0,14,0,0"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          ContentSource="SelectedContent"
                                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="V2.Settings.Slider"
           TargetType="Slider"
           BasedOn="{StaticResource {x:Type Slider}}">
        <Setter Property="Height" Value="28" />
        <Setter Property="IsMoveToPointEnabled" Value="True" />
        <Setter Property="controls:SliderHelper.ThumbFillBrush" Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="controls:SliderHelper.ThumbFillHoverBrush" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:SliderHelper.ThumbFillPressedBrush" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:SliderHelper.ThumbFillDisabledBrush" Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="controls:SliderHelper.TrackFillBrush" Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="controls:SliderHelper.TrackFillHoverBrush" Value="{StaticResource V2.Brush.TextMuted}" />
        <Setter Property="controls:SliderHelper.TrackFillPressedBrush" Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="controls:SliderHelper.TrackFillDisabledBrush" Value="{StaticResource V2.Brush.Divider}" />
        <Setter Property="controls:SliderHelper.TrackValueFillBrush" Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="controls:SliderHelper.TrackValueFillHoverBrush" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:SliderHelper.TrackValueFillPressedBrush" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:SliderHelper.TrackValueFillDisabledBrush" Value="{StaticResource V2.Brush.Border}" />
    </Style>

    <Style x:Key="V2.Settings.CheckBox"
           TargetType="CheckBox"
           BasedOn="{StaticResource {x:Type CheckBox}}">
        <Setter Property="FontFamily" Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{StaticResource V2.Brush.Text}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="controls:CheckBoxHelper.CheckBackgroundStrokeChecked" Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="controls:CheckBoxHelper.CheckBackgroundStrokeCheckedMouseOver" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:CheckBoxHelper.CheckBackgroundStrokeCheckedPressed" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:CheckBoxHelper.CheckBackgroundStrokeUnchecked" Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="controls:CheckBoxHelper.CheckBackgroundStrokeUncheckedMouseOver" Value="{StaticResource V2.Brush.TextMuted}" />
        <Setter Property="controls:CheckBoxHelper.CheckBackgroundStrokeUncheckedPressed" Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="controls:CheckBoxHelper.CheckGlyphForegroundChecked" Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="controls:CheckBoxHelper.CheckGlyphForegroundCheckedMouseOver" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:CheckBoxHelper.CheckGlyphForegroundCheckedPressed" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:CheckBoxHelper.CheckGlyphForegroundCheckedDisabled" Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="controls:CheckBoxHelper.CheckGlyphForegroundIndeterminate" Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="controls:CheckBoxHelper.CheckGlyphForegroundIndeterminateMouseOver" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:CheckBoxHelper.CheckGlyphForegroundIndeterminatePressed" Value="{StaticResource V2.Brush.AccentHover}" />
        <Setter Property="controls:CheckBoxHelper.CheckGlyphForegroundIndeterminateDisabled" Value="{StaticResource V2.Brush.Border}" />
    </Style>
</ResourceDictionary>
