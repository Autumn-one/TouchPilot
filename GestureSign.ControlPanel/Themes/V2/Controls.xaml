<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Style x:Key="V2.Button.Chrome"
           TargetType="Button">
        <Setter Property="MinHeight"
                Value="{StaticResource V2.Size.ControlHeight}" />
        <Setter Property="Padding"
                Value="{StaticResource V2.Spacing.Control}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize"
                Value="{StaticResource V2.FontSize.Body}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Cursor"
                Value="Hand" />
        <Setter Property="HorizontalContentAlignment"
                Value="Center" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="ButtonBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="{StaticResource V2.Corner.Small}"
                            SnapsToDevicePixels="True">
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          RecognizesAccessKey="True" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.88" />
                        </Trigger>
                        <Trigger Property="IsPressed"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.72" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource V2.Brush.Accent}" />
                            <Setter TargetName="ButtonBorder"
                                    Property="BorderThickness"
                                    Value="2" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ButtonBorder"
                                    Property="Opacity"
                                    Value="0.42" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="V2.Button.Primary"
           TargetType="Button"
           BasedOn="{StaticResource V2.Button.Chrome}">
        <Setter Property="Background"
                Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="Foreground"
                Value="White" />
    </Style>

    <Style x:Key="V2.Button.Secondary"
           TargetType="Button"
           BasedOn="{StaticResource V2.Button.Chrome}">
        <Setter Property="Background"
                Value="{StaticResource V2.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.Text}" />
    </Style>

    <Style x:Key="V2.Button.Ghost"
           TargetType="Button"
           BasedOn="{StaticResource V2.Button.Chrome}">
        <Setter Property="Background"
                Value="Transparent" />
        <Setter Property="BorderBrush"
                Value="Transparent" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.TextMuted}" />
    </Style>

    <Style x:Key="V2.Button.Icon"
           TargetType="Button"
           BasedOn="{StaticResource V2.Button.Ghost}">
        <Setter Property="Width"
                Value="{StaticResource V2.Size.IconButton}" />
        <Setter Property="Height"
                Value="{StaticResource V2.Size.IconButton}" />
        <Setter Property="MinHeight"
                Value="{StaticResource V2.Size.IconButton}" />
        <Setter Property="Padding"
                Value="8" />
    </Style>

    <Style x:Key="V2.Icon"
           TargetType="iconPacks:PackIconLucide">
        <Setter Property="Width"
                Value="18" />
        <Setter Property="Height"
                Value="18" />
        <Setter Property="HorizontalAlignment"
                Value="Center" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>
</ResourceDictionary>
