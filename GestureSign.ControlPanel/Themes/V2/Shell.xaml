<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks">
    <Style x:Key="V2.Navigation.TabItem"
           TargetType="TabItem">
        <Setter Property="Height"
                Value="48" />
        <Setter Property="Margin"
                Value="12,2" />
        <Setter Property="Padding"
                Value="14,0" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.Text}" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Border x:Name="ItemBorder"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="{StaticResource V2.Corner.Medium}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="3" />
                                <ColumnDefinition Width="34" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border x:Name="SelectionIndicator"
                                    Width="3"
                                    Height="22"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{StaticResource V2.Brush.Accent}"
                                    CornerRadius="0,2,2,0"
                                    Visibility="Collapsed" />
                            <iconPacks:PackIconLucide x:Name="NavigationIcon"
                                                      Grid.Column="1"
                                                      Width="19"
                                                      Height="19"
                                                      HorizontalAlignment="Center"
                                                      VerticalAlignment="Center"
                                                      Foreground="{StaticResource V2.Brush.SidebarMuted}"
                                                      Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                            <ContentPresenter x:Name="NavigationHeader"
                                              Grid.Column="2"
                                              Margin="8,0,0,0"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.FontFamily="{StaticResource V2.FontFamily}"
                                              TextElement.FontSize="14"
                                              TextElement.FontWeight="SemiBold"
                                              TextElement.Foreground="{StaticResource V2.Brush.SidebarMuted}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver"
                                 Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource V2.Brush.SidebarHover}" />
                            <Setter TargetName="NavigationIcon"
                                    Property="Foreground"
                                    Value="White" />
                            <Setter TargetName="NavigationHeader"
                                    Property="TextElement.Foreground"
                                    Value="White" />
                        </Trigger>
                        <Trigger Property="IsSelected"
                                 Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="Background"
                                    Value="{StaticResource V2.Brush.SidebarSelection}" />
                            <Setter TargetName="SelectionIndicator"
                                    Property="Visibility"
                                    Value="Visible" />
                            <Setter TargetName="NavigationIcon"
                                    Property="Foreground"
                                    Value="White" />
                            <Setter TargetName="NavigationHeader"
                                    Property="TextElement.Foreground"
                                    Value="White" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused"
                                 Value="True">
                            <Setter TargetName="ItemBorder"
                                    Property="BorderBrush"
                                    Value="{StaticResource V2.Brush.Accent}" />
                            <Setter TargetName="ItemBorder"
                                    Property="BorderThickness"
                                    Value="1" />
                        </Trigger>
                        <Trigger Property="IsEnabled"
                                 Value="False">
                            <Setter TargetName="ItemBorder"
                                    Property="Opacity"
                                    Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="V2.Navigation.TabControl"
           TargetType="TabControl">
        <Setter Property="Background"
                Value="{StaticResource V2.Brush.Canvas}" />
        <Setter Property="BorderThickness"
                Value="0" />
        <Setter Property="TabStripPlacement"
                Value="Left" />
        <Setter Property="HorizontalContentAlignment"
                Value="Stretch" />
        <Setter Property="VerticalContentAlignment"
                Value="Stretch" />
        <Setter Property="ItemsPanel">
            <Setter.Value>
                <ItemsPanelTemplate>
                    <StackPanel />
                </ItemsPanelTemplate>
            </Setter.Value>
        </Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabControl">
                    <Grid Background="{TemplateBinding Background}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource V2.Size.SidebarGridLength}" />
                            <ColumnDefinition Width="1" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border Background="{StaticResource V2.Brush.Sidebar}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="96" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="24" />
                                </Grid.RowDefinitions>
                                <Grid Margin="20,22,16,18">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="40" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="36"
                                            Height="36"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Background="{StaticResource V2.Brush.Accent}"
                                            CornerRadius="{StaticResource V2.Corner.Medium}">
                                        <iconPacks:PackIconLucide Width="20"
                                                                  Height="20"
                                                                  HorizontalAlignment="Center"
                                                                  VerticalAlignment="Center"
                                                                  Foreground="White"
                                                                  Kind="MousePointer2" />
                                    </Border>
                                    <StackPanel Grid.Column="1"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock FontFamily="{StaticResource V2.FontFamily.Display}"
                                                   FontSize="17"
                                                   FontWeight="SemiBold"
                                                   Foreground="White"
                                                   Text="GestureSign" />
                                        <TextBlock Margin="0,2,0,0"
                                                   FontFamily="{StaticResource V2.FontFamily}"
                                                   FontSize="11"
                                                   Foreground="{StaticResource V2.Brush.SidebarMuted}"
                                                   Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" />
                                    </StackPanel>
                                </Grid>
                                <ScrollViewer Grid.Row="1"
                                              HorizontalScrollBarVisibility="Disabled"
                                              VerticalScrollBarVisibility="Auto">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle"
                                                    KeyboardNavigation.TabNavigation="Local" />
                                </ScrollViewer>
                            </Grid>
                        </Border>
                        <Border Grid.Column="1"
                                Background="{StaticResource V2.Brush.Divider}" />
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="76" />
                                <RowDefinition Height="1" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border Background="{StaticResource V2.Brush.Surface}">
                                <TextBlock Margin="32,0"
                                           VerticalAlignment="Center"
                                           Style="{StaticResource V2.Text.PageTitle}"
                                           Text="{Binding SelectedItem.Header, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Border>
                            <Border Grid.Row="1"
                                    Background="{StaticResource V2.Brush.Divider}" />
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="2"
                                              Margin="24,20,24,24"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
