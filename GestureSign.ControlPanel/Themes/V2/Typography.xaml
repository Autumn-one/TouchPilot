<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="V2.Text.PageTitle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily.Display}" />
        <Setter Property="FontSize"
                Value="{StaticResource V2.FontSize.PageTitle}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.Text}" />
    </Style>

    <Style x:Key="V2.Text.SectionTitle"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize"
                Value="{StaticResource V2.FontSize.Section}" />
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.Text}" />
    </Style>

    <Style x:Key="V2.Text.Body"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize"
                Value="{StaticResource V2.FontSize.Body}" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.Text}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>

    <Style x:Key="V2.Text.Caption"
           TargetType="TextBlock">
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize"
                Value="{StaticResource V2.FontSize.Caption}" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.TextMuted}" />
        <Setter Property="TextWrapping"
                Value="Wrap" />
    </Style>
</ResourceDictionary>
