<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls">
    <Style x:Key="V2.Dialog.Window"
           TargetType="controls:MetroWindow"
           BasedOn="{StaticResource {x:Type controls:MetroWindow}}">
        <Setter Property="Background"
                Value="{StaticResource V2.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="BorderThickness"
                Value="1" />
        <Setter Property="WindowTitleBrush"
                Value="{StaticResource V2.Brush.Surface}" />
        <Setter Property="NonActiveWindowTitleBrush"
                Value="{StaticResource V2.Brush.SurfaceSubtle}" />
        <Setter Property="TitleForeground"
                Value="{StaticResource V2.Brush.Text}" />
        <Setter Property="OverrideDefaultWindowCommandsBrush"
                Value="{StaticResource V2.Brush.Text}" />
        <Setter Property="GlowBrush"
                Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="ShowIconOnTitleBar"
                Value="False" />
        <Setter Property="ShowTitleBar"
                Value="True" />
        <Setter Property="TitleBarHeight"
                Value="40" />
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily}" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.Text}" />
    </Style>

    <Style x:Key="V2.Dialog.Label"
           TargetType="TextBlock"
           BasedOn="{StaticResource V2.Text.Body}">
        <Setter Property="FontWeight"
                Value="SemiBold" />
        <Setter Property="VerticalAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="V2.Dialog.TextBox"
           TargetType="TextBox"
           BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Height"
                Value="36" />
        <Setter Property="Padding"
                Value="10,5" />
        <Setter Property="Background"
                Value="{StaticResource V2.Brush.Surface}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource V2.Brush.Border}" />
        <Setter Property="Foreground"
                Value="{StaticResource V2.Brush.Text}" />
        <Setter Property="FontFamily"
                Value="{StaticResource V2.FontFamily}" />
        <Setter Property="FontSize"
                Value="14" />
        <Setter Property="VerticalContentAlignment"
                Value="Center" />
    </Style>

    <Style x:Key="V2.Dialog.FieldGroup"
           TargetType="Border">
        <Setter Property="Padding"
                Value="16,14" />
        <Setter Property="Background"
                Value="{StaticResource V2.Brush.SurfaceSubtle}" />
        <Setter Property="BorderBrush"
                Value="{StaticResource V2.Brush.Accent}" />
        <Setter Property="BorderThickness"
                Value="3,0,0,0" />
    </Style>

    <Style x:Key="V2.Dialog.Footer"
           TargetType="Border">
        <Setter Property="Margin"
                Value="0,18,0,0" />
        <Setter Property="Padding"
                Value="0,16,0,0" />
        <Setter Property="BorderBrush"
                Value="{StaticResource V2.Brush.Divider}" />
        <Setter Property="BorderThickness"
                Value="0,1,0,0" />
    </Style>
</ResourceDictionary>
