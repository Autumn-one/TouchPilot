<UserControl x:Class="GestureSign.ControlPanel.MainWindowControls.IgnoredApplications"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
             xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
             xmlns:viewModel="clr-namespace:GestureSign.ControlPanel.ViewModel"
             xmlns:componentmodel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             Initialized="UserControl_Initialized"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="720"
             AllowDrop="True">
    <UserControl.Resources>
        <converters:MatchUsing2StringConverter x:Key="MatchUsingToStringConverter" />
        <converters:BoolConverter x:Key="boolConverter" />
        <ObjectDataProvider x:Key="ApplicationItemProvider"
                            ObjectType="{x:Type viewModel:ApplicationItemProvider}" />
        <CollectionViewSource x:Key="IgnoredApplicationViewSource"
                              Source="{Binding Source={StaticResource ApplicationItemProvider}, Path=IgnoredApplicationItems}">
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription PropertyName="MatchUsing" />
                <componentmodel:SortDescription PropertyName="." />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <Style x:Key="IgnoredApplications.HeaderText"
               TargetType="TextBlock"
               BasedOn="{StaticResource V2.Text.Caption}">
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="VerticalAlignment"
                    Value="Center" />
        </Style>
        <Style x:Key="IgnoredApplications.CellText"
               TargetType="TextBlock"
               BasedOn="{StaticResource V2.Text.Body}">
            <Setter Property="VerticalAlignment"
                    Value="Center" />
            <Setter Property="TextTrimming"
                    Value="CharacterEllipsis" />
            <Setter Property="TextWrapping"
                    Value="NoWrap" />
        </Style>
        <Style x:Key="IgnoredApplications.ListViewItem"
               TargetType="ListViewItem">
            <Setter Property="MinHeight"
                    Value="52" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Foreground"
                    Value="{StaticResource V2.Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListViewItem">
                        <Border x:Name="RowBorder"
                                Background="Transparent"
                                BorderBrush="{StaticResource V2.Brush.Divider}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource V2.Brush.Accent}"
                                        Visibility="Collapsed" />
                                <ContentPresenter Margin="12,0"
                                                  HorizontalAlignment="Stretch"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.SurfaceSubtle}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.AccentSoft}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="RowBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource V2.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="RowBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Padding="0,0,0,12"
                BorderBrush="{StaticResource V2.Brush.Divider}"
                BorderThickness="0,0,0,1">
            <Grid>
                <StackPanel HorizontalAlignment="Left"
                            Orientation="Horizontal">
                    <Button x:Name="ExportButton"
                            Style="{StaticResource V2.Button.Icon}"
                            ToolTip="{localization:LocalisedText Common.Export}"
                            AutomationProperties.Name="{localization:LocalisedText Common.Export}"
                            Click="ExportIgnoredButton_Click">
                        <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                  Kind="Upload" />
                    </Button>
                    <Button x:Name="ImportButton"
                            Margin="6,0,0,0"
                            Style="{StaticResource V2.Button.Icon}"
                            ToolTip="{localization:LocalisedText Common.Import}"
                            AutomationProperties.Name="{localization:LocalisedText Common.Import}"
                            Click="ImportButton_Click">
                        <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                  Kind="FolderOpen" />
                    </Button>
                </StackPanel>

                <StackPanel HorizontalAlignment="Right"
                            Orientation="Horizontal">
                    <Button x:Name="btnAddIgnoredApp"
                            Style="{StaticResource V2.Button.Primary}"
                            Width="36"
                            MinHeight="36"
                            Padding="8"
                            ToolTip="{localization:LocalisedText ApplicationDialog.AddIgnoredAppTitle}"
                            AutomationProperties.Name="{localization:LocalisedText ApplicationDialog.AddIgnoredAppTitle}"
                            Click="btnAddIgnoredApp_Click">
                        <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                  Kind="Plus" />
                    </Button>
                    <Button x:Name="btnEditIgnoredApp"
                            Margin="6,0,0,0"
                            Style="{StaticResource V2.Button.Icon}"
                            ToolTip="{localization:LocalisedText Action.Edit}"
                            AutomationProperties.Name="{localization:LocalisedText Action.Edit}"
                            Click="btnEditIgnoredApp_Click"
                            IsEnabled="False">
                        <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                  Kind="SquarePen" />
                    </Button>
                    <Button x:Name="btnDeleteIgnoredApp"
                            Margin="6,0,0,0"
                            Style="{StaticResource V2.Button.Icon}"
                            Foreground="{StaticResource V2.Brush.Danger}"
                            ToolTip="{localization:LocalisedText Action.Delete}"
                            AutomationProperties.Name="{localization:LocalisedText Action.Delete}"
                            Click="btnDeleteIgnoredApp_Click"
                            IsEnabled="False">
                        <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                  Kind="Trash" />
                    </Button>
                </StackPanel>
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Padding="12,0"
                Background="{StaticResource V2.Brush.SurfaceSubtle}"
                BorderBrush="{StaticResource V2.Brush.Border}"
                BorderThickness="1,0,1,1">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="76" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="1.5*" />
                    <ColumnDefinition Width="0.8*" />
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <CheckBox ToolTip="{localization:LocalisedText Ignored.Enable}"
                              AutomationProperties.Name="{localization:LocalisedText Ignored.Enable}"
                              Click="EnabledIgnoredAppCheckBoxs_Click" />
                    <TextBlock Margin="7,0,0,0"
                               Style="{StaticResource IgnoredApplications.HeaderText}"
                               Text="{localization:LocalisedText Ignored.Enable}" />
                </StackPanel>
                <TextBlock Grid.Column="1"
                           Margin="8,0"
                           Style="{StaticResource IgnoredApplications.HeaderText}"
                           Text="{localization:LocalisedText ApplicationDialog.MatchUsing}" />
                <TextBlock Grid.Column="2"
                           Margin="8,0"
                           Style="{StaticResource IgnoredApplications.HeaderText}"
                           Text="{localization:LocalisedText ApplicationDialog.AppName}" />
                <TextBlock Grid.Column="3"
                           Margin="8,0"
                           Style="{StaticResource IgnoredApplications.HeaderText}"
                           Text="{localization:LocalisedText ApplicationDialog.MatchString}" />
                <TextBlock Grid.Column="4"
                           Margin="8,0"
                           Style="{StaticResource IgnoredApplications.HeaderText}"
                           Text="{localization:LocalisedText ApplicationDialog.UsingRegularExpression}" />
            </Grid>
        </Border>

        <ListView x:Name="lstIgnoredApplications"
                  Grid.Row="2"
                  common:PrecisionScrolling.IsEnabled="True"
                  ItemsSource="{Binding Source={StaticResource IgnoredApplicationViewSource}}"
                  ItemContainerStyle="{StaticResource IgnoredApplications.ListViewItem}"
                  Background="{StaticResource V2.Brush.Surface}"
                  BorderBrush="{StaticResource V2.Brush.Border}"
                  BorderThickness="1,0,1,1"
                  ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                  ScrollViewer.PanningMode="VerticalOnly"
                  ScrollViewer.VerticalScrollBarVisibility="Auto"
                  VirtualizingPanel.ScrollUnit="Pixel"
                  MouseDoubleClick="lstIgnoredApplications_MouseDoubleClick"
                  SelectionChanged="lstIgnoredApplications_SelectionChanged">
            <ListView.ItemTemplate>
                <DataTemplate>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="76" />
                            <ColumnDefinition Width="0.9*" />
                            <ColumnDefinition Width="1.2*" />
                            <ColumnDefinition Width="1.5*" />
                            <ColumnDefinition Width="0.8*" />
                        </Grid.ColumnDefinitions>
                        <CheckBox Margin="2,0,0,0"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  IsChecked="{Binding IsEnabled}"
                                  ToolTip="{localization:LocalisedText Ignored.Enable}"
                                  Click="IgnoredAppCheckBox_Click" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0"
                                   Style="{StaticResource IgnoredApplications.CellText}"
                                   Text="{Binding MatchUsing, Converter={StaticResource MatchUsingToStringConverter}, Mode=OneWay}"
                                   ToolTip="{Binding MatchUsing, Converter={StaticResource MatchUsingToStringConverter}, Mode=OneWay}" />
                        <TextBlock Grid.Column="2"
                                   Margin="8,0"
                                   Style="{StaticResource IgnoredApplications.CellText}"
                                   Text="{Binding Name}"
                                   ToolTip="{Binding Name}" />
                        <TextBlock Grid.Column="3"
                                   Margin="8,0"
                                   Style="{StaticResource IgnoredApplications.CellText}"
                                   Text="{Binding MatchString}"
                                   ToolTip="{Binding MatchString}" />
                        <TextBlock Grid.Column="4"
                                   Margin="8,0"
                                   Style="{StaticResource IgnoredApplications.CellText}"
                                   Text="{Binding IsRegEx, Converter={StaticResource boolConverter}}" />
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>
    </Grid>
</UserControl>
