<UserControl x:Class="GestureSign.ControlPanel.MainWindowControls.EdgeTouch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalFirst">
        <StackPanel Margin="24,16,24,28">
            <controls:ToggleSwitch x:Name="EdgeTouchSwitch"
                                   Header="{localization:LocalisedText EdgeTouch.Enabled}"
                                   OnLabel="{localization:LocalisedText Options.OnLabel}"
                                   OffLabel="{localization:LocalisedText Options.OffLabel}"
                                   Click="EdgeTouchSwitch_Click" />

            <Separator Margin="0,14,0,12" />
            <TextBlock Text="{localization:LocalisedText EdgeTouch.WindowDrag}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="210" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{localization:LocalisedText EdgeTouch.WindowDragMode}"
                           FontSize="14"
                           VerticalAlignment="Center" />
                <ComboBox x:Name="WindowDragModeComboBox"
                          Grid.Column="1"
                          Width="280"
                          HorizontalAlignment="Left"
                          DisplayMemberPath="DisplayName"
                          SelectedValuePath="Value"
                          SelectionChanged="WindowDragModeComboBox_SelectionChanged" />
            </Grid>
            <TextBlock Margin="0,15,0,0"
                       Text="{Binding ElementName=WindowDragSensitivitySlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.WindowDragSensitivity}}"
                       FontSize="14" />
            <Slider x:Name="WindowDragSensitivitySlider"
                    Width="360"
                    HorizontalAlignment="Left"
                    Margin="0,7,0,0"
                    Minimum="40"
                    Maximum="250"
                    TickFrequency="10"
                    IsSnapToTickEnabled="True"
                    common:SliderTools.MoveToPointOnDrag="True"
                    ValueChanged="WindowDragSensitivitySlider_ValueChanged" />

            <Separator Margin="0,18,0,12" />
            <TextBlock Text="{localization:LocalisedText EdgeTouch.FixedGestures}"
                       FontSize="18"
                       FontWeight="SemiBold" />

            <Grid Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{localization:LocalisedText EdgeTouch.LeftEdge}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SwipeIn}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LeftSwipeInComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SlideUp}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LeftSlideUpComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SlideDown}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="LeftSlideDownComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{localization:LocalisedText EdgeTouch.RightEdge}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SwipeIn}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="RightSwipeInComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SlideUp}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="RightSlideUpComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SlideDown}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="RightSlideDownComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Grid Margin="0,18,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1*" />
                    <ColumnDefinition Width="24" />
                    <ColumnDefinition Width="1*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{localization:LocalisedText EdgeTouch.TopEdge}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SwipeIn}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="TopSwipeInComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SlideLeft}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="TopSlideLeftComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SlideRight}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="TopSlideRightComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="{localization:LocalisedText EdgeTouch.BottomEdge}"
                               FontSize="15"
                               FontWeight="SemiBold" />
                    <Grid Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SwipeIn}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="BottomSwipeInComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SlideLeft}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="BottomSlideLeftComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                    <Grid Margin="0,7,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="118" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{localization:LocalisedText EdgeTouch.SlideRight}"
                                   VerticalAlignment="Center" />
                        <ComboBox x:Name="BottomSlideRightComboBox"
                                  Grid.Column="1"
                                  DisplayMemberPath="DisplayName"
                                  SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                    </Grid>
                </StackPanel>
            </Grid>

            <Separator Margin="0,18,0,12" />
            <TextBlock Text="{localization:LocalisedText EdgeTouch.Tuning}"
                       FontSize="18"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,12,0,0"
                       Text="{Binding ElementName=EdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.EdgeZone}}"
                       FontSize="14" />
            <Slider x:Name="EdgeZoneSlider"
                    Width="360"
                    HorizontalAlignment="Left"
                    Margin="0,7,0,0"
                    Minimum="5"
                    Maximum="25"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    common:SliderTools.MoveToPointOnDrag="True"
                    ValueChanged="EdgeZoneSlider_ValueChanged" />
            <TextBlock Margin="0,13,0,0"
                       Text="{Binding ElementName=EdgeActivationSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.ActivationDistance}}"
                       FontSize="14" />
            <Slider x:Name="EdgeActivationSlider"
                    Width="360"
                    HorizontalAlignment="Left"
                    Margin="0,7,0,0"
                    Minimum="3"
                    Maximum="20"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    common:SliderTools.MoveToPointOnDrag="True"
                    ValueChanged="EdgeActivationSlider_ValueChanged" />
            <TextBlock Margin="0,13,0,0"
                       Text="{Binding ElementName=AnchorDriftSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.AnchorDrift}}"
                       FontSize="14" />
            <Slider x:Name="AnchorDriftSlider"
                    Width="360"
                    HorizontalAlignment="Left"
                    Margin="0,7,0,0"
                    Minimum="1"
                    Maximum="8"
                    TickFrequency="1"
                    IsSnapToTickEnabled="True"
                    common:SliderTools.MoveToPointOnDrag="True"
                    ValueChanged="AnchorDriftSlider_ValueChanged" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
