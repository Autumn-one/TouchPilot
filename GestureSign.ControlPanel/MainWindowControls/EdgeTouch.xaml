<UserControl x:Class="GestureSign.ControlPanel.MainWindowControls.EdgeTouch"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
             xmlns:userControls="clr-namespace:GestureSign.ControlPanel.UserControls"
             Loaded="UserControl_Loaded"
             IsVisibleChanged="UserControl_IsVisibleChanged"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <Style x:Key="EdgeTouch.EdgeGroup"
               TargetType="Border">
            <Setter Property="Padding"
                    Value="0,12,0,14" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource V2.Brush.Divider}" />
            <Setter Property="BorderThickness"
                    Value="0,1,0,0" />
        </Style>
        <Style x:Key="EdgeTouch.EdgeTitle"
               TargetType="TextBlock"
               BasedOn="{StaticResource V2.Text.Body}">
            <Setter Property="Margin"
                    Value="0,0,0,10" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
        </Style>
        <Style x:Key="EdgeTouch.ActionLabel"
               TargetType="TextBlock"
               BasedOn="{StaticResource V2.Text.Caption}">
            <Setter Property="Margin"
                    Value="0,8,0,5" />
        </Style>
        <Style x:Key="EdgeTouch.ActionSelector"
               TargetType="ComboBox"
               BasedOn="{StaticResource V2.Settings.ComboBox}">
            <Setter Property="MinWidth"
                    Value="0" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
        </Style>
        <Style x:Key="EdgeTouch.EdgeZoneSummary"
               TargetType="TextBlock"
               BasedOn="{StaticResource V2.Text.Caption}">
            <Setter Property="HorizontalAlignment"
                    Value="Center" />
            <Setter Property="TextAlignment"
                    Value="Center" />
            <Setter Property="TextWrapping"
                    Value="Wrap" />
        </Style>
        <Style x:Key="EdgeTouch.EdgeZoneExpander"
               TargetType="Expander">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Foreground"
                    Value="{StaticResource V2.Brush.Text}" />
            <Setter Property="FontFamily"
                    Value="{StaticResource V2.FontFamily}" />
            <Setter Property="FontSize"
                    Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite"
                                          MinHeight="36"
                                          HorizontalContentAlignment="Stretch"
                                          Background="Transparent"
                                          BorderThickness="0"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                          Focusable="True"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder"
                                                Padding="7,5"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="Transparent"
                                                BorderThickness="1"
                                                CornerRadius="{StaticResource V2.Corner.Small}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="28" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconLucide x:Name="Chevron"
                                                                          Width="16"
                                                                          Height="16"
                                                                          HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{StaticResource V2.Brush.Accent}"
                                                                          Kind="ChevronRight" />
                                                <ContentPresenter Grid.Column="1"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  ContentSource="Content"
                                                                  TextElement.Foreground="{StaticResource V2.Brush.Text}" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="Chevron"
                                                        Property="Kind"
                                                        Value="ChevronDown" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="HeaderBorder"
                                                        Property="Background"
                                                        Value="{StaticResource V2.Brush.AccentSoft}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused"
                                                     Value="True">
                                                <Setter TargetName="HeaderBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource V2.Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="Content"
                                              Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded"
                                     Value="True">
                                <Setter TargetName="ExpandSite"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="HeaderSite"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <SolidColorBrush x:Key="EdgeTouch.VisualizerEdgeArea"
                         Color="{StaticResource V2.Color.Accent}"
                         Opacity="0.16" />
    </UserControl.Resources>
    <ScrollViewer common:PrecisionScrolling.IsEnabled="True"
                  HorizontalScrollBarVisibility="Disabled"
                  VerticalScrollBarVisibility="Auto"
                  PanningMode="VerticalFirst">
        <StackPanel MaxWidth="760"
                    HorizontalAlignment="Stretch">
            <Border Style="{StaticResource V2.Settings.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource V2.Settings.Label}"
                               Text="{localization:LocalisedText EdgeTouch.Enabled}" />
                    <controls:ToggleSwitch x:Name="EdgeTouchSwitch"
                                           Grid.Column="1"
                                           Style="{StaticResource V2.Settings.ToggleSwitch}"
                                           OnContent="{localization:LocalisedText Options.OnLabel}"
                                           OffContent="{localization:LocalisedText Options.OffLabel}"
                                           AutomationProperties.Name="{localization:LocalisedText EdgeTouch.Enabled}"
                                           Toggled="EdgeTouchSwitch_Toggled" />
                </Grid>
            </Border>

            <Border Style="{StaticResource V2.Settings.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource V2.Settings.Label}"
                               Text="{localization:LocalisedText EdgeTouch.ConfidenceFilter}"
                               ToolTip="{localization:LocalisedText EdgeTouch.ConfidenceFilterHelp}" />
                    <controls:ToggleSwitch x:Name="ConfidenceFilterSwitch"
                                           Grid.Column="1"
                                           Style="{StaticResource V2.Settings.ToggleSwitch}"
                                           OnContent="{localization:LocalisedText Options.OnLabel}"
                                           OffContent="{localization:LocalisedText Options.OffLabel}"
                                           ToolTip="{localization:LocalisedText EdgeTouch.ConfidenceFilterHelp}"
                                           AutomationProperties.Name="{localization:LocalisedText EdgeTouch.ConfidenceFilter}"
                                           AutomationProperties.HelpText="{localization:LocalisedText EdgeTouch.ConfidenceFilterHelp}"
                                           Toggled="ConfidenceFilterSwitch_Toggled" />
                </Grid>
            </Border>

            <TextBlock Margin="0,28,0,12"
                       Style="{StaticResource V2.Settings.SectionTitle}"
                       Text="{localization:LocalisedText EdgeTouch.Visualizer}" />
            <Viewbox MaxHeight="360"
                     HorizontalAlignment="Center"
                     Stretch="Uniform"
                     StretchDirection="DownOnly">
                <userControls:TouchpadVisualizer x:Name="TouchpadPreview"
                                                 Width="620"
                                                 Height="360"
                                                 AutomationProperties.Name="{localization:LocalisedText EdgeTouch.Visualizer}"
                                                 DisconnectedText="{localization:LocalisedText EdgeTouch.VisualizerConnecting}"
                                                 EdgeAreaBrush="{StaticResource EdgeTouch.VisualizerEdgeArea}"
                                                 EdgeBoundaryBrush="{StaticResource V2.Brush.Accent}"
                                                 LeftEdgeZonePercent="{Binding ElementName=LeftEdgeZoneSlider, Path=Value}"
                                                 RightEdgeZonePercent="{Binding ElementName=RightEdgeZoneSlider, Path=Value}"
                                                 TopEdgeZonePercent="{Binding ElementName=TopEdgeZoneSlider, Path=Value}"
                                                 BottomEdgeZonePercent="{Binding ElementName=BottomEdgeZoneSlider, Path=Value}"
                                                 EmptyTextBrush="{StaticResource V2.Brush.TextMuted}"
                                                 OutlineBrush="{StaticResource V2.Brush.Border}"
                                                 SurfaceBrush="{StaticResource V2.Brush.Surface}"
                                                 WaitingText="{localization:LocalisedText EdgeTouch.VisualizerWaiting}" />
            </Viewbox>

            <TextBlock Margin="0,20,0,6"
                       Style="{StaticResource V2.Settings.SectionTitle}"
                       Text="{localization:LocalisedText EdgeTouch.Tuning}" />
            <Border Style="{StaticResource V2.Settings.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Margin="0,0,20,0"
                               Style="{StaticResource V2.Settings.Label}"
                               Text="{Binding ElementName=AllEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.AllEdgeZone}}" />
                    <Slider x:Name="AllEdgeZoneSlider"
                            Grid.Column="1"
                            Style="{StaticResource V2.Settings.Slider}"
                            Minimum="0"
                            Maximum="25"
                            TickFrequency="1"
                            SmallChange="1"
                            LargeChange="1"
                            IsSnapToTickEnabled="True"
                            common:SliderTools.MoveToPointOnDrag="True"
                            AutomationProperties.Name="{Binding ElementName=AllEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.AllEdgeZone}}"
                            PreviewMouseLeftButtonUp="AllEdgeZoneSlider_PreviewMouseLeftButtonUp"
                            ValueChanged="AllEdgeZoneSlider_ValueChanged" />
                    <UniformGrid Grid.Row="1"
                                 Grid.ColumnSpan="2"
                                 Margin="0,10,0,0"
                                 Columns="4">
                        <TextBlock Style="{StaticResource EdgeTouch.EdgeZoneSummary}"
                                   Text="{Binding ElementName=LeftEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.LeftEdgeSummary}}" />
                        <TextBlock Style="{StaticResource EdgeTouch.EdgeZoneSummary}"
                                   Text="{Binding ElementName=RightEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.RightEdgeSummary}}" />
                        <TextBlock Style="{StaticResource EdgeTouch.EdgeZoneSummary}"
                                   Text="{Binding ElementName=TopEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.TopEdgeSummary}}" />
                        <TextBlock Style="{StaticResource EdgeTouch.EdgeZoneSummary}"
                                   Text="{Binding ElementName=BottomEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.BottomEdgeSummary}}" />
                    </UniformGrid>
                </Grid>
            </Border>
            <Border Style="{StaticResource V2.Settings.Row}">
                <Expander x:Name="PerEdgeZoneExpander"
                          Style="{StaticResource EdgeTouch.EdgeZoneExpander}"
                          IsExpanded="False"
                          AutomationProperties.Name="{localization:LocalisedText EdgeTouch.PerEdgeZones}">
                    <Expander.Header>
                        <TextBlock Style="{StaticResource V2.Settings.Label}"
                                   Text="{localization:LocalisedText EdgeTouch.PerEdgeZones}" />
                    </Expander.Header>
                    <StackPanel Margin="24,8,0,0">
                        <Border Style="{StaticResource V2.Settings.Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,20,0"
                                           Style="{StaticResource V2.Settings.Label}"
                                           Text="{Binding ElementName=LeftEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.LeftEdgeZone}}" />
                                <Slider x:Name="LeftEdgeZoneSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource V2.Settings.Slider}"
                                        Minimum="0"
                                        Maximum="25"
                                        TickFrequency="1"
                                        SmallChange="1"
                                        LargeChange="1"
                                        IsSnapToTickEnabled="True"
                                        common:SliderTools.MoveToPointOnDrag="True"
                                        AutomationProperties.Name="{Binding ElementName=LeftEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.LeftEdgeZone}}"
                                        ValueChanged="EdgeZoneSlider_ValueChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource V2.Settings.Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,20,0"
                                           Style="{StaticResource V2.Settings.Label}"
                                           Text="{Binding ElementName=RightEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.RightEdgeZone}}" />
                                <Slider x:Name="RightEdgeZoneSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource V2.Settings.Slider}"
                                        Minimum="0"
                                        Maximum="25"
                                        TickFrequency="1"
                                        SmallChange="1"
                                        LargeChange="1"
                                        IsSnapToTickEnabled="True"
                                        common:SliderTools.MoveToPointOnDrag="True"
                                        AutomationProperties.Name="{Binding ElementName=RightEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.RightEdgeZone}}"
                                        ValueChanged="EdgeZoneSlider_ValueChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource V2.Settings.Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,20,0"
                                           Style="{StaticResource V2.Settings.Label}"
                                           Text="{Binding ElementName=TopEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.TopEdgeZone}}" />
                                <Slider x:Name="TopEdgeZoneSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource V2.Settings.Slider}"
                                        Minimum="0"
                                        Maximum="25"
                                        TickFrequency="1"
                                        SmallChange="1"
                                        LargeChange="1"
                                        IsSnapToTickEnabled="True"
                                        common:SliderTools.MoveToPointOnDrag="True"
                                        AutomationProperties.Name="{Binding ElementName=TopEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.TopEdgeZone}}"
                                        ValueChanged="EdgeZoneSlider_ValueChanged" />
                            </Grid>
                        </Border>
                        <Border Style="{StaticResource V2.Settings.Row}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="280" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Margin="0,0,20,0"
                                           Style="{StaticResource V2.Settings.Label}"
                                           Text="{Binding ElementName=BottomEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.BottomEdgeZone}}" />
                                <Slider x:Name="BottomEdgeZoneSlider"
                                        Grid.Column="1"
                                        Style="{StaticResource V2.Settings.Slider}"
                                        Minimum="0"
                                        Maximum="25"
                                        TickFrequency="1"
                                        SmallChange="1"
                                        LargeChange="1"
                                        IsSnapToTickEnabled="True"
                                        common:SliderTools.MoveToPointOnDrag="True"
                                        AutomationProperties.Name="{Binding ElementName=BottomEdgeZoneSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.BottomEdgeZone}}"
                                        ValueChanged="EdgeZoneSlider_ValueChanged" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Expander>
            </Border>
            <Border Style="{StaticResource V2.Settings.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,20,0"
                               Style="{StaticResource V2.Settings.Label}"
                               Text="{Binding ElementName=EdgeActivationSlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.ActivationDistance}}" />
                    <Slider x:Name="EdgeActivationSlider"
                            Grid.Column="1"
                            Style="{StaticResource V2.Settings.Slider}"
                            Minimum="3"
                            Maximum="20"
                            TickFrequency="1"
                            IsSnapToTickEnabled="True"
                            common:SliderTools.MoveToPointOnDrag="True"
                            ValueChanged="EdgeActivationSlider_ValueChanged" />
                </Grid>
            </Border>

            <TextBlock Margin="0,28,0,6"
                       Style="{StaticResource V2.Settings.SectionTitle}"
                       Text="{localization:LocalisedText EdgeTouch.WindowDrag}" />
            <Border Style="{StaticResource V2.Settings.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource V2.Settings.Label}"
                               Text="{localization:LocalisedText EdgeTouch.WindowDragEnabled}" />
                    <controls:ToggleSwitch x:Name="WindowDragSwitch"
                                           Grid.Column="1"
                                           Style="{StaticResource V2.Settings.ToggleSwitch}"
                                           OnContent="{localization:LocalisedText Options.OnLabel}"
                                           OffContent="{localization:LocalisedText Options.OffLabel}"
                                           AutomationProperties.Name="{localization:LocalisedText EdgeTouch.WindowDragEnabled}"
                                           Toggled="WindowDragSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource V2.Settings.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Style="{StaticResource V2.Settings.Label}"
                               Text="{localization:LocalisedText EdgeTouch.WindowDragBringToFront}" />
                    <controls:ToggleSwitch x:Name="WindowDragBringToFrontSwitch"
                                           Grid.Column="1"
                                           Style="{StaticResource V2.Settings.ToggleSwitch}"
                                           OnContent="{localization:LocalisedText Options.OnLabel}"
                                           OffContent="{localization:LocalisedText Options.OffLabel}"
                                           AutomationProperties.Name="{localization:LocalisedText EdgeTouch.WindowDragBringToFront}"
                                           Toggled="WindowDragBringToFrontSwitch_Toggled" />
                </Grid>
            </Border>
            <Border Style="{StaticResource V2.Settings.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="420" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,20,0"
                               Style="{StaticResource V2.Settings.Label}"
                               Text="{localization:LocalisedText EdgeTouch.WindowDragImplementation}" />
                    <ComboBox x:Name="WindowDragImplementationComboBox"
                              Grid.Column="1"
                              Style="{StaticResource V2.Settings.ComboBox}"
                              DisplayMemberPath="DisplayName"
                              SelectedValuePath="Value"
                              AutomationProperties.Name="{localization:LocalisedText EdgeTouch.WindowDragImplementation}"
                              SelectionChanged="WindowDragImplementationComboBox_SelectionChanged" />
                </Grid>
            </Border>
            <Border Style="{StaticResource V2.Settings.Row}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="280" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Margin="0,0,20,0"
                               Style="{StaticResource V2.Settings.Label}"
                               Text="{Binding ElementName=WindowDragSensitivitySlider, Path=Value, StringFormat={localization:LocalisedText EdgeTouch.WindowDragSensitivity}}" />
                    <Slider x:Name="WindowDragSensitivitySlider"
                            Grid.Column="1"
                            Style="{StaticResource V2.Settings.Slider}"
                            Minimum="40"
                            Maximum="250"
                            TickFrequency="10"
                            IsSnapToTickEnabled="True"
                            common:SliderTools.MoveToPointOnDrag="True"
                            ValueChanged="WindowDragSensitivitySlider_ValueChanged" />
                </Grid>
            </Border>

            <TextBlock Margin="0,28,0,14"
                       Style="{StaticResource V2.Settings.SectionTitle}"
                       Text="{localization:LocalisedText EdgeTouch.FixedGestures}" />
            <TabControl Style="{StaticResource V2.Settings.SegmentedTabControl}">
                <TabItem Header="{localization:LocalisedText EdgeTouch.OneFinger}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border Style="{StaticResource EdgeTouch.EdgeGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EdgeTouch.EdgeTitle}"
                                           Text="{localization:LocalisedText EdgeTouch.LeftEdge}" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SwipeIn}" />
                                <ComboBox x:Name="LeftSwipeInComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SlideUp}" />
                                <ComboBox x:Name="LeftSlideUpComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SlideDown}" />
                                <ComboBox x:Name="LeftSlideDownComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2"
                                Style="{StaticResource EdgeTouch.EdgeGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EdgeTouch.EdgeTitle}"
                                           Text="{localization:LocalisedText EdgeTouch.RightEdge}" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SwipeIn}" />
                                <ComboBox x:Name="RightSwipeInComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SlideUp}" />
                                <ComboBox x:Name="RightSlideUpComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SlideDown}" />
                                <ComboBox x:Name="RightSlideDownComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Margin="0,14,0,0"
                                Style="{StaticResource EdgeTouch.EdgeGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EdgeTouch.EdgeTitle}"
                                           Text="{localization:LocalisedText EdgeTouch.TopEdge}" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SwipeIn}" />
                                <ComboBox x:Name="TopSwipeInComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SlideLeft}" />
                                <ComboBox x:Name="TopSlideLeftComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SlideRight}" />
                                <ComboBox x:Name="TopSlideRightComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Row="1"
                                Grid.Column="2"
                                Margin="0,14,0,0"
                                Style="{StaticResource EdgeTouch.EdgeGroup}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource EdgeTouch.EdgeTitle}"
                                           Text="{localization:LocalisedText EdgeTouch.BottomEdge}" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SwipeIn}" />
                                <ComboBox x:Name="BottomSwipeInComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SlideLeft}" />
                                <ComboBox x:Name="BottomSlideLeftComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                                <TextBlock Style="{StaticResource EdgeTouch.ActionLabel}"
                                           Text="{localization:LocalisedText EdgeTouch.SlideRight}" />
                                <ComboBox x:Name="BottomSlideRightComboBox"
                                          Style="{StaticResource EdgeTouch.ActionSelector}"
                                          DisplayMemberPath="DisplayName"
                                          SelectionChanged="FixedGestureComboBox_SelectionChanged" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </TabItem>

                <TabItem Header="{localization:LocalisedText EdgeTouch.TwoFingers}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
