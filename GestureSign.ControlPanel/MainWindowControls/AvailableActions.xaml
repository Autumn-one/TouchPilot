<UserControl x:Class="GestureSign.ControlPanel.MainWindowControls.AvailableActions"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             xmlns:applications="clr-namespace:GestureSign.Common.Applications;assembly=GestureSign.Common"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
             xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
             xmlns:viewModel="clr-namespace:GestureSign.ControlPanel.ViewModel"
             xmlns:componentmodel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             mc:Ignorable="d"
             d:DesignHeight="560"
             d:DesignWidth="720"
             Initialized="UserControl_Initialized"
             AllowDrop="True">
    <UserControl.Resources>
        <converters:ActionTitleConverter x:Key="ActionTitleConverter" />
        <converters:ApplicationListHeaderConverter x:Key="ApplicationListHeaderConverter" />
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
        <converters:GestureButtonImageConverter x:Key="GestureButtonImageConverter" />

        <ObjectDataProvider x:Key="GestureItemProvider"
                            ObjectType="{x:Type viewModel:GestureItemProvider}" />
        <ObjectDataProvider x:Key="ApplicationItemProvider"
                            ObjectType="{x:Type viewModel:ApplicationItemProvider}" />
        <ObjectDataProvider x:Key="CommandInfoProvider"
                            ObjectType="{x:Type viewModel:CommandInfoProvider}" />

        <CollectionViewSource x:Key="ActionsViewSource"
                              Source="{Binding Source={StaticResource CommandInfoProvider}, Path=CommandInfos}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Action" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription PropertyName="ActionName"
                                                Direction="Ascending" />
                <componentmodel:SortDescription PropertyName="."
                                                Direction="Ascending" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="ApplicationViewSource"
                              Source="{Binding Source={StaticResource ApplicationItemProvider}, Path=ApplicationItems}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Group" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription PropertyName="." />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>

        <Style x:Key="Actions.ToggleSwitch"
               TargetType="controls:ToggleSwitch"
               BasedOn="{StaticResource V2.Settings.ToggleSwitch}">
            <Setter Property="Width"
                    Value="54" />
            <Setter Property="MinWidth"
                    Value="54" />
            <Setter Property="Margin"
                    Value="0" />
        </Style>

        <Style x:Key="Actions.IconButton.Danger"
               TargetType="Button"
               BasedOn="{StaticResource V2.Button.Icon}">
            <Setter Property="Foreground"
                    Value="{StaticResource V2.Brush.Danger}" />
        </Style>

        <Style x:Key="Actions.ListBoxItem"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <EventSetter Event="MouseDoubleClick"
                         Handler="ListBoxItem_OnMouseDoubleClick" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Foreground"
                    Value="{StaticResource V2.Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                MinHeight="44"
                                Background="Transparent"
                                BorderBrush="{StaticResource V2.Brush.Divider}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource V2.Brush.Accent}"
                                        Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.SurfaceSubtle}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.AccentSoft}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource V2.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ItemBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Actions.CommandItem"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource Actions.ListBoxItem}">
            <Setter Property="MinHeight"
                    Value="64" />
        </Style>

        <Style x:Key="Actions.GroupExpander"
               TargetType="Expander">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Expander">
                        <Grid Background="{TemplateBinding Background}">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ToggleButton x:Name="HeaderSite"
                                          MinHeight="40"
                                          Padding="10,7"
                                          HorizontalContentAlignment="Stretch"
                                          Background="{StaticResource V2.Brush.SurfaceSubtle}"
                                          BorderThickness="0"
                                          Content="{TemplateBinding Header}"
                                          ContentTemplate="{TemplateBinding HeaderTemplate}"
                                          ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                                          Focusable="True"
                                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="HeaderBorder"
                                                Padding="{TemplateBinding Padding}"
                                                Background="{TemplateBinding Background}"
                                                BorderBrush="{StaticResource V2.Brush.Divider}"
                                                BorderThickness="0,0,0,1">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="24" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <iconPacks:PackIconLucide x:Name="Chevron"
                                                                          Width="16"
                                                                          Height="16"
                                                                          HorizontalAlignment="Left"
                                                                          VerticalAlignment="Center"
                                                                          Foreground="{StaticResource V2.Brush.Accent}"
                                                                          Kind="ChevronRight" />
                                                <ContentPresenter Grid.Column="1"
                                                                  HorizontalAlignment="Stretch"
                                                                  VerticalAlignment="Center"
                                                                  ContentSource="Content" />
                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked"
                                                     Value="True">
                                                <Setter TargetName="Chevron"
                                                        Property="Kind"
                                                        Value="ChevronDown" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver"
                                                     Value="True">
                                                <Setter TargetName="HeaderBorder"
                                                        Property="Background"
                                                        Value="{StaticResource V2.Brush.AccentSoft}" />
                                            </Trigger>
                                            <Trigger Property="IsKeyboardFocused"
                                                     Value="True">
                                                <Setter TargetName="HeaderBorder"
                                                        Property="BorderBrush"
                                                        Value="{StaticResource V2.Brush.Accent}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter x:Name="ExpandSite"
                                              Grid.Row="1"
                                              HorizontalAlignment="Stretch"
                                              VerticalAlignment="Stretch"
                                              ContentSource="Content"
                                              Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsExpanded"
                                     Value="True">
                                <Setter TargetName="ExpandSite"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="HeaderSite"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Actions.GestureButton"
               TargetType="Button">
            <Setter Property="Padding"
                    Value="8" />
            <Setter Property="Background"
                    Value="{StaticResource V2.Brush.SurfaceSubtle}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource V2.Brush.Divider}" />
            <Setter Property="BorderThickness"
                    Value="0,0,1,0" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Top" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="GestureBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="GestureBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.AccentSoft}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="GestureBorder"
                                        Property="Opacity"
                                        Value="0.75" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="GestureBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource V2.Brush.Accent}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid SnapsToDevicePixels="True"
          UseLayoutRounding="True">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="210" />
            <ColumnDefinition Width="12" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0"
                Background="{StaticResource V2.Brush.Surface}"
                BorderBrush="{StaticResource V2.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource V2.Corner.Medium}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="49" />
                </Grid.RowDefinitions>

                <Border Padding="12,0,8,0"
                        BorderBrush="{StaticResource V2.Brush.Divider}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource V2.Text.SectionTitle}"
                                   FontSize="16"
                                   Text="{localization:LocalisedText Gesture.Applications}" />
                        <Button x:Name="NewApplicationButton"
                                Width="36"
                                MinHeight="36"
                                Padding="8"
                                HorizontalAlignment="Right"
                                Style="{StaticResource V2.Button.Primary}"
                                ToolTip="{localization:LocalisedText ApplicationDialog.AddApplication}"
                                AutomationProperties.Name="{localization:LocalisedText ApplicationDialog.AddApplication}"
                                Click="NewApplicationButton_OnClick">
                            <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                      Kind="Plus" />
                        </Button>
                    </Grid>
                </Border>

                <ListBox x:Name="lstAvailableApplication"
                         Grid.Row="1"
                         common:PrecisionScrolling.IsEnabled="True"
                         ItemsSource="{Binding Source={StaticResource ApplicationViewSource}}"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.PanningMode="VerticalOnly"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         VirtualizingPanel.IsVirtualizing="True"
                         VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         SelectionChanged="lstAvailableApplication_SelectionChanged"
                         ContextMenuOpening="lstAvailableApplication_ContextMenuOpening">
                    <ListBox.ContextMenu>
                        <ContextMenu FontFamily="{StaticResource V2.FontFamily}"
                                     FontSize="14">
                            <MenuItem x:Name="PasteActionMenuItem2"
                                      Header="{localization:LocalisedText Action.PasteAction}"
                                      Click="PasteToNewActionMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="EditMenuItem"
                                      Header="{localization:LocalisedText Action.Edit}"
                                      Click="EditApplication_Click" />
                            <MenuItem x:Name="DeleteMenuItem"
                                      Header="{localization:LocalisedText Action.Delete}"
                                      Click="DeleteMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander Style="{StaticResource Actions.GroupExpander}"
                                                          IsExpanded="True">
                                                    <Expander.Header>
                                                        <TextBlock Style="{StaticResource V2.Text.Caption}"
                                                                   FontWeight="SemiBold">
                                                            <TextBlock.Text>
                                                                <MultiBinding Converter="{StaticResource ApplicationListHeaderConverter}">
                                                                    <Binding Path="Name"
                                                                             Mode="OneWay" />
                                                                    <Binding Path="ItemCount"
                                                                             Mode="OneWay" />
                                                                </MultiBinding>
                                                            </TextBlock.Text>
                                                        </TextBlock>
                                                    </Expander.Header>
                                                    <ItemsPresenter />
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid Height="44"
                                  Margin="12,0,6,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="32" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Center"
                                           Style="{StaticResource V2.Text.Body}"
                                           Text="{Binding Name}"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Name}" />
                                <Button Grid.Column="1"
                                        Width="30"
                                        Height="30"
                                        Padding="6"
                                        ToolTip="{localization:LocalisedText Action.Edit}"
                                        AutomationProperties.Name="{localization:LocalisedText Action.Edit}"
                                        Click="EditApplication_Click">
                                    <Button.Style>
                                        <Style TargetType="Button"
                                               BasedOn="{StaticResource V2.Button.Ghost}">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                                             Value="True">
                                                    <Setter Property="Visibility"
                                                            Value="Visible" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                    <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                              Kind="SquarePen" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource Actions.ListBoxItem}">
                            <Setter Property="AutomationProperties.Name"
                                    Value="{Binding Name}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                </ListBox>

                <Border Grid.Row="2"
                        Padding="8,6"
                        Background="{StaticResource V2.Brush.SurfaceSubtle}"
                        BorderBrush="{StaticResource V2.Brush.Divider}"
                        BorderThickness="0,1,0,0">
                    <StackPanel HorizontalAlignment="Left"
                                Orientation="Horizontal">
                        <Button x:Name="ExportButton"
                                Style="{StaticResource V2.Button.Icon}"
                                ToolTip="{localization:LocalisedText Common.Export}"
                                AutomationProperties.Name="{localization:LocalisedText Common.Export}"
                                Click="ExportActionMenuItem_Click">
                            <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                      Kind="Upload" />
                        </Button>
                        <Button x:Name="ImportButton"
                                Margin="4,0,0,0"
                                Style="{StaticResource V2.Button.Icon}"
                                ToolTip="{localization:LocalisedText Common.Import}"
                                AutomationProperties.Name="{localization:LocalisedText Common.Import}"
                                Click="ImportButton_Click">
                            <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                      Kind="FolderOpen" />
                        </Button>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <Border Grid.Column="2"
                Background="{StaticResource V2.Brush.Surface}"
                BorderBrush="{StaticResource V2.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource V2.Corner.Medium}"
                ClipToBounds="True">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="48" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="49" />
                </Grid.RowDefinitions>

                <Border Padding="12,0,10,0"
                        BorderBrush="{StaticResource V2.Brush.Divider}"
                        BorderThickness="0,0,0,1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock VerticalAlignment="Center"
                                   Style="{StaticResource V2.Text.Body}"
                                   FontWeight="SemiBold"
                                   TextTrimming="CharacterEllipsis">
                            <Run Text="{Binding ElementName=lstAvailableApplication, Path=SelectedItem.(applications:IApplication.Name), Mode=OneWay}" />
                            <Run Text="{Binding ElementName=lstAvailableActions, Path=Items.Groups.Count, Mode=OneWay, StringFormat={localization:LocalisedText Action.ActionCount}}" />
                        </TextBlock>
                        <StackPanel Grid.Column="1"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                            <TextBlock Margin="0,0,8,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource V2.Text.Caption}"
                                       Text="{localization:LocalisedText Ignored.Enable}" />
                            <controls:ToggleSwitch x:Name="ToggleAllActionsToggleSwitch"
                                                   Style="{StaticResource Actions.ToggleSwitch}"
                                                   IsEnabled="False"
                                                   OffContent=""
                                                   OnContent=""
                                                   ToolTip="{localization:LocalisedText Action.EnableAll}"
                                                   AutomationProperties.Name="{localization:LocalisedText Action.EnableAll}"
                                                   Toggled="ToggleAllActionsToggleSwitch_Toggled" />
                        </StackPanel>
                    </Grid>
                </Border>

                <ListBox x:Name="lstAvailableActions"
                         Grid.Row="1"
                         common:PrecisionScrolling.IsEnabled="True"
                         ItemsSource="{Binding Source={StaticResource ActionsViewSource}}"
                         SelectedValuePath="CommandName"
                         SelectionMode="Extended"
                         Background="Transparent"
                         BorderThickness="0"
                         ScrollViewer.CanContentScroll="False"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         ScrollViewer.PanningMode="VerticalOnly"
                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                         ContextMenuOpening="LstAvailableActions_OnContextMenuOpening"
                         SelectionChanged="lstAvailableActions_SelectionChanged"
                         ScrollViewer.ScrollChanged="LstAvailableActions_OnScrollChanged">
                    <ListBox.GroupStyle>
                        <GroupStyle>
                            <GroupStyle.ContainerStyle>
                                <Style TargetType="GroupItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="GroupItem">
                                                <Expander Style="{StaticResource Actions.GroupExpander}"
                                                          IsExpanded="True"
                                                          AutomationProperties.Name="{Binding Name, Converter={StaticResource ActionTitleConverter}}">
                                                    <Expander.Header>
                                                        <TextBlock Style="{StaticResource V2.Text.Body}"
                                                                   FontWeight="SemiBold"
                                                                   Text="{Binding Name, Converter={StaticResource ActionTitleConverter}}"
                                                                   TextWrapping="Wrap" />
                                                    </Expander.Header>
                                                    <Grid MinHeight="78">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="112" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <Button x:Name="ActionButton"
                                                                Style="{StaticResource Actions.GestureButton}"
                                                                ToolTip="{localization:LocalisedText Action.SelectGesture}"
                                                                AutomationProperties.Name="{localization:LocalisedText Action.SelectGesture}"
                                                                Click="ActionButton_Click">
                                                            <Grid x:Name="GestureImageGrid"
                                                                  Height="62"
                                                                  VerticalAlignment="Top">
                                                                <TextBlock HorizontalAlignment="Center"
                                                                           VerticalAlignment="Center"
                                                                           Text="{localization:LocalisedText Action.SelectGesture}"
                                                                           TextAlignment="Center"
                                                                           TextWrapping="Wrap"
                                                                           IsHitTestVisible="False">
                                                                    <TextBlock.Style>
                                                                        <Style TargetType="TextBlock"
                                                                               BasedOn="{StaticResource V2.Text.Caption}">
                                                                            <Setter Property="Visibility"
                                                                                    Value="Collapsed" />
                                                                            <Style.Triggers>
                                                                                <DataTrigger Binding="{Binding ElementName=GestureImage, Path=Source}"
                                                                                             Value="{x:Null}">
                                                                                    <Setter Property="Visibility"
                                                                                            Value="Visible" />
                                                                                </DataTrigger>
                                                                            </Style.Triggers>
                                                                        </Style>
                                                                    </TextBlock.Style>
                                                                </TextBlock>
                                                                <Image x:Name="GestureImage"
                                                                       Width="82"
                                                                       Height="56"
                                                                       HorizontalAlignment="Center"
                                                                       VerticalAlignment="Center"
                                                                       Stretch="Uniform"
                                                                       StretchDirection="DownOnly">
                                                                    <Image.Source>
                                                                        <MultiBinding Converter="{StaticResource GestureButtonImageConverter}">
                                                                            <Binding Source="{StaticResource GestureItemProvider}"
                                                                                     Path="InstanceGestureMap"
                                                                                     Mode="OneWay" />
                                                                            <Binding Path="Name.GestureName"
                                                                                     Mode="OneWay" />
                                                                        </MultiBinding>
                                                                    </Image.Source>
                                                                </Image>
                                                            </Grid>
                                                        </Button>
                                                        <ItemsPresenter Grid.Column="1" />
                                                    </Grid>
                                                </Expander>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </GroupStyle.ContainerStyle>
                        </GroupStyle>
                    </ListBox.GroupStyle>
                    <ListBox.ContextMenu>
                        <ContextMenu FontFamily="{StaticResource V2.FontFamily}"
                                     FontSize="14">
                            <MenuItem x:Name="SortMenuItem"
                                      Header="{localization:LocalisedText Action.Sort}">
                                <MenuItem x:Name="SortByNameMenuItem"
                                          Header="{localization:LocalisedText ActionDialog.ActionName}"
                                          IsCheckable="True"
                                          IsChecked="True"
                                          Click="SortMenuItem_Click"
                                          Checked="SortMenuItem_Checked" />
                                <MenuItem x:Name="SortByGestureMenuItem"
                                          Header="{localization:LocalisedText Gesture.Header}"
                                          IsCheckable="True"
                                          Click="SortMenuItem_Click"
                                          Checked="SortMenuItem_Checked" />
                            </MenuItem>
                            <Separator />
                            <MenuItem x:Name="CutActionMenuItem"
                                      Header="{localization:LocalisedText Action.CutAction}"
                                      Click="CutActionMenuItem_Click" />
                            <MenuItem x:Name="CopyActionMenuItem"
                                      Header="{localization:LocalisedText Action.CopyAction}"
                                      Click="CopyActionMenuItem_Click" />
                            <MenuItem x:Name="PasteToNewActionMenuItem"
                                      Header="{localization:LocalisedText Action.PasteToNewAction}"
                                      Click="PasteToNewActionMenuItem_Click" />
                            <MenuItem x:Name="PasteToSelectedActionMenuItem"
                                      Header="{localization:LocalisedText Action.PasteToSelectedAction}"
                                      Click="PasteToSelectedActionMenuItem_Click" />
                            <Separator />
                            <MenuItem x:Name="DelActionMenuItem"
                                      Header="{localization:LocalisedText Action.Delete}"
                                      Click="cmdDeleteCommand_Click" />
                            <Separator />
                            <MenuItem x:Name="ExportActionMenuItem"
                                      Header="{localization:LocalisedText Common.Export}"
                                      Click="ExportActionMenuItem_Click" />
                        </ContextMenu>
                    </ListBox.ContextMenu>
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid MinHeight="64"
                                  Margin="12,7,8,7">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="62" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource V2.Text.Body}"
                                               FontWeight="SemiBold"
                                               Text="{Binding CommandName}"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CommandName}" />
                                    <TextBlock Margin="0,3,0,0"
                                               MaxHeight="34"
                                               Style="{StaticResource V2.Text.Caption}"
                                               Text="{Binding Description}"
                                               TextWrapping="Wrap"
                                               ToolTip="{Binding Description}" />
                                </StackPanel>
                                <controls:ToggleSwitch Grid.Column="1"
                                                       HorizontalAlignment="Right"
                                                       VerticalAlignment="Center"
                                                       Style="{StaticResource Actions.ToggleSwitch}"
                                                       IsOn="{Binding IsEnabled}"
                                                       OffContent=""
                                                       OnContent=""
                                                       ToolTip="{localization:LocalisedText Ignored.Enable}"
                                                       AutomationProperties.Name="{Binding CommandName}"
                                                       Toggled="CommandCheckBox_Toggled" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                    <ListBox.ItemContainerStyle>
                        <Style TargetType="ListBoxItem"
                               BasedOn="{StaticResource Actions.CommandItem}">
                            <Setter Property="AutomationProperties.Name"
                                    Value="{Binding CommandName}" />
                        </Style>
                    </ListBox.ItemContainerStyle>
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel IsItemsHost="True" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>

                <Border Grid.Row="2"
                        Padding="8,6"
                        Background="{StaticResource V2.Brush.SurfaceSubtle}"
                        BorderBrush="{StaticResource V2.Brush.Divider}"
                        BorderThickness="0,1,0,0">
                    <Grid>
                        <StackPanel HorizontalAlignment="Left"
                                    Orientation="Horizontal">
                            <Button x:Name="MoveUpButton"
                                    Style="{StaticResource V2.Button.Icon}"
                                    IsEnabled="False"
                                    ToolTip="{localization:LocalisedText Action.MoveUp}"
                                    AutomationProperties.Name="{localization:LocalisedText Action.MoveUp}"
                                    Click="MoveUpButton_Click">
                                <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                          Kind="ChevronUp" />
                            </Button>
                            <Button x:Name="MoveDownButton"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource V2.Button.Icon}"
                                    IsEnabled="False"
                                    ToolTip="{localization:LocalisedText Action.MoveDown}"
                                    AutomationProperties.Name="{localization:LocalisedText Action.MoveDown}"
                                    Click="MoveDownButton_Click">
                                <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                          Kind="ChevronDown" />
                            </Button>
                        </StackPanel>

                        <StackPanel HorizontalAlignment="Right"
                                    Orientation="Horizontal">
                            <Button x:Name="btnAddAction"
                                    Width="36"
                                    MinHeight="36"
                                    Padding="8"
                                    Style="{StaticResource V2.Button.Primary}"
                                    ToolTip="{localization:LocalisedText Action.NewCommand}"
                                    AutomationProperties.Name="{localization:LocalisedText Action.NewCommand}"
                                    Click="btnAddAction_Click">
                                <Button.ContextMenu>
                                    <ContextMenu FontFamily="{StaticResource V2.FontFamily}"
                                                 FontSize="14">
                                        <MenuItem x:Name="NewCommandMenuItem"
                                                  Header="{localization:LocalisedText Action.NewCommand}"
                                                  Click="NewCommandMenuItem_Click" />
                                        <MenuItem x:Name="FromSelectedMenuItem"
                                                  Header="{localization:LocalisedText Action.FromSelected}"
                                                  Click="FromSelectedMenuItem_Click" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                                <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                          Kind="Plus" />
                            </Button>
                            <Button x:Name="cmdEdit"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource V2.Button.Icon}"
                                    IsEnabled="False"
                                    ToolTip="{localization:LocalisedText Action.Edit}"
                                    AutomationProperties.Name="{localization:LocalisedText Action.Edit}"
                                    Click="cmdEditCommand_Click">
                                <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                          Kind="SquarePen" />
                            </Button>
                            <Button x:Name="cmdDelete"
                                    Margin="4,0,0,0"
                                    Style="{StaticResource Actions.IconButton.Danger}"
                                    IsEnabled="False"
                                    ToolTip="{localization:LocalisedText Action.Delete}"
                                    AutomationProperties.Name="{localization:LocalisedText Action.Delete}"
                                    Click="cmdDeleteCommand_Click">
                                <iconPacks:PackIconLucide Style="{StaticResource V2.Icon}"
                                                          Kind="Trash" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
