<UserControl x:Class="GestureSign.ControlPanel.UserControls.Crosshair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="36"
             d:DesignWidth="36">
    <UserControl.Style>
        <Style TargetType="UserControl">
            <Setter Property="Opacity"
                    Value="1" />
            <Style.Triggers>
                <Trigger Property="IsEnabled"
                         Value="False">
                    <Setter Property="Opacity"
                            Value="0.4" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </UserControl.Style>

    <Grid Width="36"
          Height="36">
        <Ellipse Width="36"
                 Height="36"
                 Fill="{StaticResource V2.Brush.AccentSoft}"
                 Stroke="{StaticResource V2.Brush.Accent}"
                 StrokeThickness="1.5"
                 MouseDown="Crosshair_MouseDown"
                 MouseMove="Crosshair_MouseMove"
                 MouseUp="Crosshair_MouseUp" />
        <Path x:Name="Dragger"
              Width="24"
              Height="24"
              IsHitTestVisible="False"
              Data="M4,12 H20 M12,4 V20 M12,8 A4,4 0 1 1 11.99,8"
              Stretch="Uniform"
              Stroke="{StaticResource V2.Brush.Accent}"
              StrokeThickness="1.5" />
    </Grid>
</UserControl>
