<UserControl x:Class="GestureSign.ControlPanel.UserControls.GestureSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
             xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
             mc:Ignorable="d"
             d:DesignHeight="190"
             d:DesignWidth="360"
             Loaded="UserControl_Loaded"
             Unloaded="UserControl_Unloaded">
    <UserControl.Resources>
        <converters:GestureImageConverter x:Key="GestureImageConverter" />
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="132" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource V2.Brush.SurfaceSubtle}"
                BorderBrush="{StaticResource V2.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource V2.Corner.Small}"
                Cursor="Hand"
                MouseLeftButtonDown="imgGestureThumbnail_MouseLeftButtonDown">
            <Grid>
                <Image x:Name="imgGestureThumbnail"
                       Height="96"
                       Margin="18"
                       Source="{Binding CurrentGesture.PointPatterns, ConverterParameter=96, Converter={StaticResource GestureImageConverter}, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}"
                       Stretch="Uniform"
                       StretchDirection="DownOnly" />
                <TextBlock x:Name="DrawGestureTextBlock"
                           Margin="24"
                           HorizontalAlignment="Center"
                           VerticalAlignment="Center"
                           Style="{StaticResource V2.Text.Body}"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource V2.Brush.Accent}"
                           Text="{localization:LocalisedText GestureDefinition.DrawGesture}"
                           TextAlignment="Center"
                           TextWrapping="Wrap"
                           Visibility="Collapsed" />
            </Grid>
        </Border>

        <Grid Grid.Row="1"
              Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock x:Name="ExistingTextBlock"
                       Margin="0,0,12,0"
                       VerticalAlignment="Center"
                       Style="{StaticResource V2.Text.Caption}"
                       Foreground="{StaticResource V2.Brush.Warning}"
                       Text="{localization:LocalisedText GestureDefinition.ExistingGesture}"
                       TextWrapping="Wrap"
                       Visibility="Collapsed" />
            <Button x:Name="RedrawButton"
                    Grid.Column="1"
                    MinWidth="110"
                    Style="{StaticResource V2.Button.Secondary}"
                    ToolTip="{localization:LocalisedText GestureDefinition.Redraw}"
                    AutomationProperties.Name="{localization:LocalisedText GestureDefinition.Redraw}"
                    Click="RedrawButton_Click"
                    Focusable="False">
                <StackPanel Orientation="Horizontal">
                    <iconPacks:PackIconLucide Width="17"
                                              Height="17"
                                              Margin="0,0,7,0"
                                              VerticalAlignment="Center"
                                              Kind="RotateCcw" />
                    <TextBlock VerticalAlignment="Center"
                               Text="{localization:LocalisedText GestureDefinition.Redraw}" />
                </StackPanel>
            </Button>
        </Grid>
    </Grid>
</UserControl>
