<UserControl x:Class="GestureSign.ControlPanel.UserControls.MatchUsingRadio"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="40"
             d:DesignWidth="320">
    <UserControl.Resources>
        <Style x:Key="MatchUsing.Segment"
               TargetType="RadioButton">
            <Setter Property="Height"
                    Value="36" />
            <Setter Property="Margin"
                    Value="1" />
            <Setter Property="Padding"
                    Value="8,0" />
            <Setter Property="Foreground"
                    Value="{StaticResource V2.Brush.TextMuted}" />
            <Setter Property="FontFamily"
                    Value="{StaticResource V2.FontFamily}" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Center" />
            <Setter Property="VerticalContentAlignment"
                    Value="Center" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="SegmentBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource V2.Corner.Small}">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="Content"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.AccentSoft}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource V2.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsChecked"
                                     Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.Accent}" />
                                <Setter TargetName="SegmentBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource V2.Brush.Accent}" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="SegmentBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource V2.Brush.AccentHover}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="SegmentBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Border Padding="2"
            Background="{StaticResource V2.Brush.SurfaceSubtle}"
            BorderBrush="{StaticResource V2.Brush.Border}"
            BorderThickness="1"
            CornerRadius="{StaticResource V2.Corner.Small}">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <RadioButton x:Name="FileNameRadio"
                         Style="{StaticResource MatchUsing.Segment}"
                         GroupName="MatchUsing"
                         Content="{localization:LocalisedText Common.FileName}"
                         IsChecked="True" />
            <RadioButton x:Name="TitleRadio"
                         Grid.Column="1"
                         Style="{StaticResource MatchUsing.Segment}"
                         GroupName="MatchUsing"
                         Content="{localization:LocalisedText Common.WindowTitle}" />
            <RadioButton x:Name="ClassRadio"
                         Grid.Column="2"
                         Style="{StaticResource MatchUsing.Segment}"
                         GroupName="MatchUsing"
                         Content="{localization:LocalisedText Common.WindowClass}" />
        </Grid>
    </Border>
</UserControl>
