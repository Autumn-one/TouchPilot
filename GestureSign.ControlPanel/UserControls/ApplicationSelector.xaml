<UserControl x:Class="GestureSign.ControlPanel.UserControls.ApplicationSelector"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
             xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
             xmlns:componentmodel="clr-namespace:System.ComponentModel;assembly=WindowsBase"
             mc:Ignorable="d"
             d:DesignHeight="300"
             d:DesignWidth="600"
             Background="{StaticResource V2.Brush.Surface}">
    <UserControl.Resources>
        <converters:ApplicationListHeaderConverter x:Key="ApplicationListHeaderConverter" />
        <converters:CommandConverter x:Key="CommandConverter" />
        <converters:GestureButtonImageConverter x:Key="GestureButtonImageConverter" />
        <converters:MatchUsing2StringConverter x:Key="MatchUsingToStringConverter" />

        <CollectionViewSource x:Key="ApplicationViewSource"
                              Filter="AppCollectionViewSource_Filter"
                              Source="{Binding UserAppList, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Application.Group" />
            </CollectionViewSource.GroupDescriptions>
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription PropertyName="." />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="ActionViewSource"
                              Culture="{x:Static common:UIHelper.CurrentCulture}"
                              Filter="CollectionViewSource_Filter"
                              Source="{Binding SelectedItem.ActionItemList, ElementName=AppListBox}">
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription PropertyName="Action.Name" />
            </CollectionViewSource.SortDescriptions>
        </CollectionViewSource>
        <CollectionViewSource x:Key="IgnoredAppViewSource"
                              Culture="{x:Static common:UIHelper.CurrentCulture}"
                              Source="{Binding IgnoredAppList, RelativeSource={RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}}">
            <CollectionViewSource.SortDescriptions>
                <componentmodel:SortDescription PropertyName="." />
            </CollectionViewSource.SortDescriptions>
            <CollectionViewSource.GroupDescriptions>
                <PropertyGroupDescription PropertyName="Application.MatchUsing" />
            </CollectionViewSource.GroupDescriptions>
        </CollectionViewSource>

        <Style x:Key="Selector.TabItem"
               TargetType="TabItem">
            <Setter Property="MinWidth"
                    Value="104" />
            <Setter Property="Height"
                    Value="34" />
            <Setter Property="Margin"
                    Value="1" />
            <Setter Property="Padding"
                    Value="14,0" />
            <Setter Property="FontFamily"
                    Value="{StaticResource V2.FontFamily}" />
            <Setter Property="FontSize"
                    Value="13" />
            <Setter Property="FontWeight"
                    Value="SemiBold" />
            <Setter Property="Foreground"
                    Value="{StaticResource V2.Brush.TextMuted}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabItem">
                        <Border x:Name="TabBorder"
                                Padding="{TemplateBinding Padding}"
                                Background="Transparent"
                                BorderBrush="Transparent"
                                BorderThickness="1"
                                CornerRadius="{StaticResource V2.Corner.Small}">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              ContentSource="Header"
                                              RecognizesAccessKey="True"
                                              TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.AccentSoft}" />
                                <Setter Property="Foreground"
                                        Value="{StaticResource V2.Brush.Text}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.Accent}" />
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource V2.Brush.Accent}" />
                                <Setter Property="Foreground"
                                        Value="White" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="TabBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource V2.Brush.AccentHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Selector.TabControl"
               TargetType="TabControl">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="ItemContainerStyle"
                    Value="{StaticResource Selector.TabItem}" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TabControl">
                        <Grid Background="{TemplateBinding Background}"
                              KeyboardNavigation.TabNavigation="Local">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Border HorizontalAlignment="Left"
                                    Padding="2"
                                    Background="{StaticResource V2.Brush.SurfaceSubtle}"
                                    BorderBrush="{StaticResource V2.Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="{StaticResource V2.Corner.Small}">
                                <TabPanel IsItemsHost="True" />
                            </Border>
                            <ContentPresenter x:Name="PART_SelectedContentHost"
                                              Grid.Row="1"
                                              Margin="0,8,0,0"
                                              HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                              VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                              ContentSource="SelectedContent"
                                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}" />
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Selector.ColumnHeader"
               TargetType="Border">
            <Setter Property="Height"
                    Value="40" />
            <Setter Property="Padding"
                    Value="8,4" />
            <Setter Property="Background"
                    Value="{StaticResource V2.Brush.SurfaceSubtle}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource V2.Brush.Divider}" />
            <Setter Property="BorderThickness"
                    Value="0,0,0,1" />
        </Style>

        <Style x:Key="Selector.GroupHeader"
               TargetType="Border">
            <Setter Property="MinHeight"
                    Value="30" />
            <Setter Property="Padding"
                    Value="8,3" />
            <Setter Property="Background"
                    Value="{StaticResource V2.Brush.SurfaceSubtle}" />
            <Setter Property="BorderBrush"
                    Value="{StaticResource V2.Brush.Accent}" />
            <Setter Property="BorderThickness"
                    Value="3,0,0,0" />
        </Style>

        <Style x:Key="Selector.SearchBox"
               TargetType="TextBox"
               BasedOn="{StaticResource V2.Dialog.TextBox}">
            <Setter Property="Height"
                    Value="32" />
            <Setter Property="Padding"
                    Value="8,4" />
            <Setter Property="FontSize"
                    Value="13" />
        </Style>

        <Style x:Key="Selector.CheckBox"
               TargetType="CheckBox"
               BasedOn="{StaticResource V2.Settings.CheckBox}" />

        <Style x:Key="Selector.ListBox"
               TargetType="ListBox"
               BasedOn="{StaticResource {x:Type ListBox}}">
            <Setter Property="Background"
                    Value="Transparent" />
            <Setter Property="BorderThickness"
                    Value="0" />
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility"
                    Value="Disabled" />
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility"
                    Value="Auto" />
            <Setter Property="VirtualizingPanel.IsVirtualizing"
                    Value="True" />
            <Setter Property="VirtualizingPanel.VirtualizationMode"
                    Value="Recycling" />
            <Setter Property="VirtualizingPanel.ScrollUnit"
                    Value="Pixel" />
            <Setter Property="common:PrecisionScrolling.IsEnabled"
                    Value="True" />
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
        </Style>

        <Style x:Key="Selector.ListBoxItem"
               TargetType="ListBoxItem"
               BasedOn="{StaticResource {x:Type ListBoxItem}}">
            <Setter Property="HorizontalContentAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalContentAlignment"
                    Value="Stretch" />
            <Setter Property="Foreground"
                    Value="{StaticResource V2.Brush.Text}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="ItemBorder"
                                Background="Transparent"
                                BorderBrush="{StaticResource V2.Brush.Divider}"
                                BorderThickness="0,0,0,1"
                                SnapsToDevicePixels="True">
                            <Grid>
                                <Border x:Name="SelectionIndicator"
                                        Width="3"
                                        HorizontalAlignment="Left"
                                        Background="{StaticResource V2.Brush.Accent}"
                                        Visibility="Collapsed" />
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                                  ContentSource="Content"
                                                  TextElement.Foreground="{TemplateBinding Foreground}" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.SurfaceSubtle}" />
                            </Trigger>
                            <Trigger Property="IsSelected"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="Background"
                                        Value="{StaticResource V2.Brush.AccentSoft}" />
                                <Setter TargetName="SelectionIndicator"
                                        Property="Visibility"
                                        Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="ItemBorder"
                                        Property="BorderBrush"
                                        Value="{StaticResource V2.Brush.Accent}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="ItemBorder"
                                        Property="Opacity"
                                        Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <TabControl x:Name="AppTabControl"
                Style="{StaticResource Selector.TabControl}">
        <TabItem Header="{Binding ElementName=AppListBox, Path=Items.Count}"
                 HeaderStringFormat="{localization:LocalisedText ExportImportDialog.ApplicationHeader}">
            <Grid ClipToBounds="True">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="1" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Selector.ColumnHeader}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox x:Name="AllAppCheckBox"
                                      Style="{StaticResource Selector.CheckBox}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      Click="AllAppCheckBox_Click" />
                            <TextBox x:Name="AppFilterTextBox"
                                     Grid.Column="1"
                                     Style="{StaticResource Selector.SearchBox}"
                                     VerticalAlignment="Center"
                                     TextChanged="AppFilterTextBox_TextChanged"
                                     controls:TextBoxHelper.Watermark="{localization:LocalisedText ExportImportDialog.SearchApplication}" />
                        </Grid>
                    </Border>
                    <ListBox x:Name="AppListBox"
                             Grid.Row="1"
                             Style="{StaticResource Selector.ListBox}"
                             ItemContainerStyle="{StaticResource Selector.ListBoxItem}"
                             ItemsSource="{Binding Source={StaticResource ApplicationViewSource}}"
                             VirtualizingPanel.IsVirtualizingWhenGrouping="True">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Border Style="{StaticResource Selector.GroupHeader}">
                                            <CheckBox x:Name="AppGroupCheckBox"
                                                      Style="{StaticResource Selector.CheckBox}"
                                                      HorizontalContentAlignment="Left"
                                                      VerticalContentAlignment="Center"
                                                      Click="AppGroupCheckBox_Click">
                                                <TextBlock Style="{StaticResource V2.Text.Caption}"
                                                           FontWeight="SemiBold"
                                                           TextWrapping="NoWrap"
                                                           TextTrimming="CharacterEllipsis">
                                                    <TextBlock.Text>
                                                        <MultiBinding Converter="{StaticResource ApplicationListHeaderConverter}">
                                                            <Binding Path="Name" />
                                                            <Binding Path="ItemCount" />
                                                        </MultiBinding>
                                                    </TextBlock.Text>
                                                </TextBlock>
                                            </CheckBox>
                                        </Border>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="44"
                                      Margin="8,0,6,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="AppCheckBox"
                                              Style="{StaticResource Selector.CheckBox}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                                    <TextBlock Grid.Column="1"
                                               VerticalAlignment="Center"
                                               Style="{StaticResource V2.Text.Body}"
                                               Text="{Binding Application.Name}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Application.Name}" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="1"
                        Background="{StaticResource V2.Brush.Divider}" />

                <Grid Grid.Column="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Selector.ColumnHeader}">
                        <TextBox x:Name="ActionFilterTextBox"
                                 Style="{StaticResource Selector.SearchBox}"
                                 VerticalAlignment="Center"
                                 TextChanged="ActionFilterTextBox_TextChanged"
                                 controls:TextBoxHelper.Watermark="{localization:LocalisedText ExportImportDialog.SearchAction}" />
                    </Border>
                    <ListBox x:Name="ActionListBox"
                             Grid.Row="1"
                             Style="{StaticResource Selector.ListBox}"
                             ItemContainerStyle="{StaticResource Selector.ListBoxItem}"
                             ItemsSource="{Binding Source={StaticResource ActionViewSource}}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid MinHeight="72"
                                      Margin="7,3,6,3">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="28" />
                                        <ColumnDefinition Width="56" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <CheckBox x:Name="ActionCheckBox"
                                              Style="{StaticResource Selector.CheckBox}"
                                              HorizontalAlignment="Left"
                                              VerticalAlignment="Center"
                                              IsChecked="{Binding IsSelected, Mode=TwoWay}"
                                              Click="ActionCheckBox_Click" />
                                    <Image x:Name="GestureImage"
                                           Grid.Column="1"
                                           Width="52"
                                           Height="52"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center"
                                           Stretch="Uniform"
                                           StretchDirection="DownOnly">
                                        <Image.Source>
                                            <MultiBinding Converter="{StaticResource GestureButtonImageConverter}"
                                                          ConverterParameter="56">
                                                <Binding RelativeSource="{RelativeSource AncestorType={x:Type UserControl}, Mode=FindAncestor}"
                                                         Path="GestureMap"
                                                         Mode="OneWay" />
                                                <Binding Path="Action.GestureName"
                                                         Mode="OneWay" />
                                            </MultiBinding>
                                        </Image.Source>
                                    </Image>
                                    <StackPanel Grid.Column="2"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center">
                                        <TextBlock Style="{StaticResource V2.Text.Body}"
                                                   FontSize="13"
                                                   FontWeight="SemiBold"
                                                   Text="{Binding Action.Name}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Action.Name}" />
                                        <TextBlock Margin="0,3,0,0"
                                                   Style="{StaticResource V2.Text.Caption}"
                                                   Foreground="{StaticResource V2.Brush.Accent}"
                                                   Text="{Binding Info}"
                                                   TextWrapping="NoWrap"
                                                   TextTrimming="CharacterEllipsis"
                                                   ToolTip="{Binding Info}" />
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>

                <Border Grid.Column="3"
                        Background="{StaticResource V2.Brush.Divider}" />

                <Grid Grid.Column="4">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="40" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Border Style="{StaticResource Selector.ColumnHeader}">
                        <TextBlock HorizontalAlignment="Left"
                                   VerticalAlignment="Center"
                                   Style="{StaticResource V2.Dialog.Label}"
                                   Text="{localization:LocalisedText ExportImportDialog.Commands}" />
                    </Border>
                    <ListBox x:Name="CommandListBox"
                             Grid.Row="1"
                             Style="{StaticResource Selector.ListBox}"
                             ItemContainerStyle="{StaticResource Selector.ListBoxItem}"
                             DataContext="{Binding ElementName=ActionListBox, Path=SelectedItem.Action}"
                             ItemsSource="{Binding Commands}">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel MinHeight="52"
                                            Margin="10,6"
                                            VerticalAlignment="Center"
                                            DataContext="{Binding Converter={StaticResource CommandConverter}, Mode=OneWay}">
                                    <TextBlock Style="{StaticResource V2.Text.Body}"
                                               FontWeight="SemiBold"
                                               Text="{Binding CommandName}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding CommandName}" />
                                    <TextBlock Margin="0,3,0,0"
                                               Style="{StaticResource V2.Text.Caption}"
                                               Foreground="{StaticResource V2.Brush.Accent}"
                                               Text="{Binding Description}"
                                               TextWrapping="NoWrap"
                                               TextTrimming="CharacterEllipsis"
                                               ToolTip="{Binding Description}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Grid>
        </TabItem>

        <TabItem Header="{Binding ElementName=IgnoredListBox, Path=Items.Count}"
                 HeaderStringFormat="{localization:LocalisedText ExportImportDialog.IgnoreHeader}">
            <ListBox x:Name="IgnoredListBox"
                     Style="{StaticResource Selector.ListBox}"
                     ItemContainerStyle="{StaticResource Selector.ListBoxItem}"
                     ItemsSource="{Binding Source={StaticResource IgnoredAppViewSource}}">
                <ListBox.GroupStyle>
                    <GroupStyle>
                        <GroupStyle.HeaderTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource Selector.GroupHeader}">
                                    <TextBlock VerticalAlignment="Center"
                                               Style="{StaticResource V2.Text.Caption}"
                                               FontWeight="SemiBold"
                                               Text="{Binding Path=Name, Converter={StaticResource MatchUsingToStringConverter}, Mode=OneWay}" />
                                </Border>
                            </DataTemplate>
                        </GroupStyle.HeaderTemplate>
                    </GroupStyle>
                </ListBox.GroupStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="54"
                              Margin="10,3,8,3">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="30" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <CheckBox Style="{StaticResource Selector.CheckBox}"
                                      HorizontalAlignment="Left"
                                      VerticalAlignment="Center"
                                      IsChecked="{Binding IsSelected, Mode=TwoWay}" />
                            <StackPanel Grid.Column="1"
                                        VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource V2.Text.Body}"
                                           FontWeight="SemiBold"
                                           Text="{Binding Application.Name}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Application.Name}" />
                                <TextBlock Margin="0,3,0,0"
                                           Style="{StaticResource V2.Text.Caption}"
                                           Foreground="{StaticResource V2.Brush.Accent}"
                                           Text="{Binding Application.MatchString}"
                                           TextWrapping="NoWrap"
                                           TextTrimming="CharacterEllipsis"
                                           ToolTip="{Binding Application.MatchString}" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </TabItem>
    </TabControl>
</UserControl>
