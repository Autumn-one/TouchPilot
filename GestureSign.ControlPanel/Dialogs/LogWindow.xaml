<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.LogWindow"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                      xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
                      mc:Ignorable="d"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      Title="{localization:LocalisedText About.SendFeedback}"
                      Style="{StaticResource V2.Dialog.Window}"
                      SizeToContent="Height"
                      Width="600"
                      BorderThickness="1"
                      WindowStartupLocation="CenterScreen"
                      WindowStyle="ToolWindow"
                      ResizeMode="CanMinimize"
                      Icon="/TouchPilot.ControlPanel;component/Resources/normal.ico">
    <controls:MetroWindow.Resources>
        <BooleanToVisibilityConverter x:Key="BooleanToVisibilityConverter" />
    </controls:MetroWindow.Resources>

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBox x:Name="LogTextBox"
                 common:PrecisionScrolling.IsEnabled="True"
                 Height="230"
                 Margin="0,0,0,16"
                 Padding="10,8"
                 Style="{StaticResource V2.Dialog.TextBox}"
                 Background="{StaticResource V2.Brush.SurfaceSubtle}"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 HorizontalScrollBarVisibility="Auto"
                 VerticalScrollBarVisibility="Visible"
                 Visibility="{Binding ElementName=VisibilityCheckBox, Path=IsChecked, Converter={StaticResource BooleanToVisibilityConverter}}" />

        <Border Grid.Row="1"
                Style="{StaticResource V2.Dialog.FieldGroup}">
            <StackPanel>
                <TextBlock Style="{StaticResource V2.Text.Body}"
                           Text="{localization:LocalisedText About.FeedbackTip}"
                           TextWrapping="Wrap" />
                <TextBox x:Name="MessageTextBox"
                         Margin="0,10,0,0"
                         Style="{StaticResource V2.Dialog.TextBox}" />
                <CheckBox x:Name="VisibilityCheckBox"
                          Margin="0,14,0,0"
                          HorizontalAlignment="Left"
                          Style="{StaticResource V2.Settings.CheckBox}"
                          Content="{localization:LocalisedText About.ShowReport}" />
                <TextBlock Margin="0,14,0,0"
                           Style="{StaticResource V2.Text.Body}"
                           Text="{localization:LocalisedText About.Contact}"
                           TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource V2.Dialog.Footer}">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Width="96"
                        Style="{StaticResource V2.Button.Secondary}"
                        Content="{localization:LocalisedText Common.Cancel}"
                        IsCancel="True" />
                <Button x:Name="OkButton"
                        Width="120"
                        Margin="8,0,0,0"
                        Style="{StaticResource V2.Button.Primary}"
                        Content="{localization:LocalisedText About.SendButton}"
                        Click="OkButton_Click"
                        IsDefault="True" />
            </StackPanel>
        </Border>
    </Grid>
</controls:MetroWindow>
