<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.GestureDefinition"
                      x:Name="GestureDefinition1"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                      xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                      xmlns:usercontrols="clr-namespace:GestureSign.ControlPanel.UserControls"
                      Title="{localization:LocalisedText GestureDefinition.Edit}"
                      Style="{StaticResource V2.Dialog.Window}"
                      Width="430"
                      ResizeMode="NoResize"
                      SizeToContent="Height"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      Topmost="True"
                      Icon="/TouchPilot.ControlPanel;component/Resources/normal.ico"
                      WindowStartupLocation="CenterScreen">
    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <usercontrols:GestureSelector x:Name="GestureSelector"
                                      CurrentGesture="{Binding ElementName=GestureDefinition1, Path=CurrentGesture, Mode=TwoWay}" />

        <Border Grid.Row="1"
                Style="{StaticResource V2.Dialog.Footer}">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="cmdCancel"
                        Width="96"
                        Style="{StaticResource V2.Button.Secondary}"
                        Content="{localization:LocalisedText Common.Cancel}"
                        IsCancel="True"
                        Focusable="False" />
                <Button x:Name="cmdDone"
                        Width="96"
                        Margin="8,0,0,0"
                        Style="{StaticResource V2.Button.Primary}"
                        Content="{localization:LocalisedText Common.OK}"
                        IsDefault="True"
                        Focusable="False"
                        Click="cmdDone_Click" />
            </StackPanel>
        </Border>
    </Grid>
</controls:MetroWindow>
