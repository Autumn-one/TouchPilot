<controls:MetroWindow x:Class="GestureSign.ControlPanel.Dialogs.CommandDialog"
                      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                      xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                      xmlns:controls="clr-namespace:MahApps.Metro.Controls;assembly=MahApps.Metro"
                      xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                      xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
                      mc:Ignorable="d"
                      d:DesignHeight="520"
                      d:DesignWidth="430"
                      Title="{localization:LocalisedText CommandDialog.EditCommandTitle}"
                      Style="{StaticResource V2.Dialog.Window}"
                      Width="430"
                      WindowStyle="ToolWindow"
                      SizeToContent="Height"
                      Icon="/GestureSign.ControlPanel;component/Resources/normal.ico"
                      WindowStartupLocation="CenterScreen"
                      FlowDirection="{StaticResource DefaultFlowDirection}"
                      ResizeMode="CanMinimize"
                      Loaded="MetroWindow_Loaded">
    <controls:MetroWindow.Resources>
        <Style TargetType="ScrollViewer"
               BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="common:DragScrolling.IsEnabled"
                    Value="True" />
        </Style>
        <Style x:Key="CommandDialog.DropDownScrollViewer"
               TargetType="ScrollViewer"
               BasedOn="{StaticResource {x:Type ScrollViewer}}">
            <Setter Property="common:DragScrolling.IsEnabled"
                    Value="False" />
            <Setter Property="common:PrecisionScrolling.IsEnabled"
                    Value="True" />
        </Style>
    </controls:MetroWindow.Resources>

    <controls:MetroWindow.Flyouts>
        <controls:FlyoutsControl>
            <controls:Flyout x:Name="MessageFlyout"
                             Theme="Light"
                             Position="Bottom"
                             CloseButtonVisibility="Collapsed"
                             IsPinned="False"
                             MinHeight="72"
                             Background="{StaticResource V2.Brush.Surface}"
                             Foreground="{StaticResource V2.Brush.Text}">
                <TextBlock x:Name="MessageFlyoutText"
                           Margin="16,10"
                           VerticalAlignment="Center"
                           Style="{StaticResource V2.Text.Body}"
                           TextWrapping="Wrap" />
            </controls:Flyout>
        </controls:FlyoutsControl>
    </controls:MetroWindow.Flyouts>

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Style="{StaticResource V2.Dialog.Label}"
                       Text="{localization:LocalisedText CommandDialog.SelectCommand}" />
            <ComboBox x:Name="cmbPlugins"
                      Margin="0,6,0,0"
                      Style="{StaticResource V2.Settings.ComboBox}"
                      ScrollViewer.CanContentScroll="False"
                      MaxDropDownHeight="300"
                      AutomationProperties.Name="{localization:LocalisedText CommandDialog.SelectCommand}"
                      SelectionChanged="cmbPlugins_SelectionChanged">
                <ComboBox.Resources>
                    <Style TargetType="ScrollViewer"
                           BasedOn="{StaticResource CommandDialog.DropDownScrollViewer}" />
                </ComboBox.Resources>
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="34">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="26" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Path Width="20"
                                  Height="20"
                                  HorizontalAlignment="Left"
                                  VerticalAlignment="Center"
                                  Data="{Binding Icon}"
                                  Fill="{StaticResource V2.Brush.Accent}"
                                  Stretch="Uniform" />
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource V2.Text.Body}"
                                       Text="{Binding DisplayText}"
                                       TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>

            <Border Margin="0,16,0,0"
                    Padding="14"
                    Background="{StaticResource V2.Brush.SurfaceSubtle}"
                    BorderBrush="{StaticResource V2.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource V2.Corner.Small}"
                    Visibility="{Binding ElementName=SettingsContent, Path=Visibility}">
                <ContentControl x:Name="SettingsContent"
                                HorizontalContentAlignment="Center" />
            </Border>
        </StackPanel>

        <Border Grid.Row="1"
                Margin="0,18,0,0"
                Padding="0,16,0,0"
                BorderBrush="{StaticResource V2.Brush.Divider}"
                BorderThickness="0,1,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource V2.Dialog.Label}"
                           Text="{localization:LocalisedText CommandDialog.CommandName}" />
                <TextBox x:Name="CommandNameTextBox"
                         Margin="0,6,0,0"
                         Style="{StaticResource V2.Dialog.TextBox}"
                         MaxLines="3"
                         MaxLength="80"
                         AutomationProperties.Name="{localization:LocalisedText CommandDialog.CommandName}"
                         controls:TextBoxHelper.Watermark="{localization:LocalisedText CommandDialog.CommandNameWatermark}" />
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Style="{StaticResource V2.Dialog.Footer}">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="cmdCancel"
                        Width="96"
                        Style="{StaticResource V2.Button.Secondary}"
                        Content="{localization:LocalisedText Common.Cancel}"
                        IsCancel="True" />
                <Button x:Name="cmdDone"
                        Width="96"
                        Margin="8,0,0,0"
                        Style="{StaticResource V2.Button.Primary}"
                        Content="{localization:LocalisedText Common.Save}"
                        IsDefault="True"
                        Click="cmdDone_Click" />
            </StackPanel>
        </Border>
    </Grid>
</controls:MetroWindow>
