<common:TouchWindow x:Class="GestureSign.ControlPanel.Dialogs.ApplicationDialog"
                    x:Name="AppDialog"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:controls="http://metro.mahapps.com/winfx/xaml/controls"
                    xmlns:iconPacks="http://metro.mahapps.com/winfx/xaml/iconpacks"
                    xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
                    xmlns:flyouts="clr-namespace:GestureSign.ControlPanel.Flyouts"
                    xmlns:common="clr-namespace:GestureSign.ControlPanel.Common"
                    xmlns:converters="clr-namespace:GestureSign.ControlPanel.Converters"
                    xmlns:usercontrols="clr-namespace:GestureSign.ControlPanel.UserControls"
                    mc:Ignorable="d"
                    d:DesignHeight="650"
                    d:DesignWidth="700"
                    Style="{StaticResource V2.Dialog.Window}"
                    Icon="/GestureSign.ControlPanel;component/Resources/normal.ico"
                    Width="700"
                    MaxHeight="720"
                    SizeToContent="Height"
                    WindowStyle="ToolWindow"
                    WindowStartupLocation="CenterScreen"
                    FlowDirection="{StaticResource DefaultFlowDirection}"
                    ResizeMode="CanMinimize"
                    AllowDrop="True"
                    Loaded="ApplicationDialog_OnLoaded">
    <common:TouchWindow.Resources>
        <converters:MatchStringConverter x:Key="MatchStringConverter" />
    </common:TouchWindow.Resources>

    <controls:MetroWindow.Flyouts>
        <controls:FlyoutsControl>
            <controls:Flyout x:Name="MessageFlyout"
                             Theme="Light"
                             Position="Bottom"
                             CloseButtonVisibility="Collapsed"
                             IsPinned="False"
                             MinHeight="72"
                             Background="{StaticResource V2.Brush.Surface}"
                             Foreground="{StaticResource V2.Brush.Text}">
                <TextBlock x:Name="MessageFlyoutText"
                           Margin="16,10"
                           VerticalAlignment="Center"
                           Style="{StaticResource V2.Text.Body}"
                           TextWrapping="Wrap" />
            </controls:Flyout>
            <flyouts:RuningApplicationsFlyout x:Name="RuningAppFlyout" />
        </controls:FlyoutsControl>
    </controls:MetroWindow.Flyouts>

    <Grid Margin="24,20,24,22">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ScrollViewer MaxHeight="560"
                      common:PrecisionScrolling.IsEnabled="True"
                      HorizontalScrollBarVisibility="Disabled"
                      VerticalScrollBarVisibility="Auto"
                      PanningMode="VerticalOnly">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="25" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Style="{StaticResource V2.Dialog.Label}"
                               Text="{localization:LocalisedText ApplicationDialog.GetMatchString}" />
                    <Border Margin="0,8,0,0"
                            Style="{StaticResource V2.Dialog.FieldGroup}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="44" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Margin="0,0,12,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource V2.Text.Caption}"
                                       Text="{localization:LocalisedText ApplicationDialog.DragCrosshair}"
                                       TextWrapping="Wrap" />
                            <usercontrols:Crosshair x:Name="chCrosshair"
                                                    Grid.Column="1"
                                                    Width="36"
                                                    Height="36"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ToolTip="{localization:LocalisedText ApplicationDialog.DragCrosshair}"
                                                    AutomationProperties.Name="{localization:LocalisedText ApplicationDialog.DragCrosshair}"
                                                    CrosshairDragged="chCrosshair_CrosshairDragged"
                                                    CrosshairDragging="ChCrosshair_OnCrosshairDragging" />
                        </Grid>
                    </Border>

                    <StackPanel Margin="0,10,0,0">
                        <Button x:Name="ShowRunningButton"
                                Style="{StaticResource V2.Button.Secondary}"
                                ToolTip="{localization:LocalisedText ApplicationDialog.ShowRunningApplications}"
                                AutomationProperties.Name="{localization:LocalisedText ApplicationDialog.ShowRunningApplications}"
                                Click="ShowRunningButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Width="17"
                                                          Height="17"
                                                          Margin="0,0,7,0"
                                                          VerticalAlignment="Center"
                                                          Kind="List" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{localization:LocalisedText ApplicationDialog.ShowRunningApplications}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BrowseButton"
                                Margin="0,8,0,0"
                                Style="{StaticResource V2.Button.Secondary}"
                                ToolTip="{localization:LocalisedText ApplicationDialog.Browse}"
                                AutomationProperties.Name="{localization:LocalisedText ApplicationDialog.Browse}"
                                Click="BrowseButton_Click">
                            <StackPanel Orientation="Horizontal">
                                <iconPacks:PackIconLucide Width="17"
                                                          Height="17"
                                                          Margin="0,0,7,0"
                                                          VerticalAlignment="Center"
                                                          Kind="FolderOpen" />
                                <TextBlock VerticalAlignment="Center"
                                           Text="{localization:LocalisedText ApplicationDialog.Browse}"
                                           TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <TextBlock x:Name="GroupNameTextBlock"
                               Margin="0,16,0,0"
                               Style="{StaticResource V2.Dialog.Label}"
                               Text="{localization:LocalisedText ApplicationDialog.Group}" />
                    <ComboBox x:Name="GroupComboBox"
                              Margin="0,6,0,0"
                              Style="{StaticResource V2.Settings.ComboBox}"
                              IsEditable="True"
                              AutomationProperties.Name="{localization:LocalisedText ApplicationDialog.Group}"
                              controls:TextBoxHelper.Watermark="{localization:LocalisedText Action.DefaultGroup}" />

                    <TextBlock x:Name="ApplicationNameTextBlock"
                               Margin="0,16,0,0"
                               Style="{StaticResource V2.Dialog.Label}"
                               Text="{localization:LocalisedText ApplicationDialog.AppName}" />
                    <TextBox x:Name="ApplicationNameTextBox"
                             Margin="0,6,0,0"
                             Style="{StaticResource V2.Dialog.TextBox}"
                             Text="{Binding ElementName=AppDialog, Path=ApplicationListViewItem.WindowTitle, Mode=TwoWay}"
                             AutomationProperties.Name="{localization:LocalisedText ApplicationDialog.AppName}"
                             controls:TextBoxHelper.Watermark="{localization:LocalisedText ApplicationDialog.AppNameWatermark}" />
                </StackPanel>

                <Border Grid.Column="1"
                        Width="1"
                        HorizontalAlignment="Center"
                        Background="{StaticResource V2.Brush.Divider}" />

                <StackPanel Grid.Column="2">
                    <TextBlock Style="{StaticResource V2.Dialog.Label}"
                               Text="{localization:LocalisedText ApplicationDialog.MatchUsing}" />
                    <usercontrols:MatchUsingRadio x:Name="matchUsingRadio"
                                                  Margin="0,6,0,0"
                                                  Height="40" />

                    <TextBlock Margin="0,16,0,0"
                               Style="{StaticResource V2.Dialog.Label}"
                               Text="{localization:LocalisedText ApplicationDialog.MatchString}" />
                    <TextBox x:Name="MatchStringTextBox"
                             Margin="0,6,0,0"
                             Style="{StaticResource V2.Dialog.TextBox}"
                             AutomationProperties.Name="{localization:LocalisedText ApplicationDialog.MatchString}"
                             GotKeyboardFocus="MatchStringTextBox_OnGotKeyboardFocus"
                             controls:TextBoxHelper.Watermark="{localization:LocalisedText ApplicationDialog.MatchStringWatermark}">
                        <MultiBinding Converter="{StaticResource MatchStringConverter}"
                                      Mode="TwoWay">
                            <Binding ElementName="AppDialog"
                                     Path="ApplicationListViewItem"
                                     Mode="TwoWay" />
                            <Binding ElementName="matchUsingRadio"
                                     Path="MatchUsing"
                                     Mode="TwoWay" />
                        </MultiBinding>
                    </TextBox>
                    <Popup x:Name="MatchStringPopup"
                           PlacementTarget="{Binding ElementName=MatchStringTextBox}"
                           Placement="Center"
                           StaysOpen="{Binding ElementName=MatchStringTextBox, Path=IsKeyboardFocused}">
                        <TextBox x:Name="MatchStringPopupTextBox"
                                 MinWidth="310"
                                 MaxWidth="400"
                                 MinHeight="52"
                                 Padding="10,7"
                                 Background="{StaticResource V2.Brush.Surface}"
                                 BorderBrush="{StaticResource V2.Brush.Accent}"
                                 Foreground="{StaticResource V2.Brush.Text}"
                                 FontFamily="{StaticResource V2.FontFamily}"
                                 FontSize="14"
                                 Text="{Binding ElementName=MatchStringTextBox, Path=Text, Mode=TwoWay}"
                                 TextWrapping="Wrap" />
                    </Popup>

                    <CheckBox x:Name="RegexCheckBox"
                              Margin="0,12,0,0"
                              Style="{StaticResource V2.Settings.CheckBox}"
                              Content="{localization:LocalisedText ApplicationDialog.UsingRegularExpression}" />
                    <CheckBox x:Name="MatchActivatedCheckBox"
                              Margin="0,10,0,0"
                              Style="{StaticResource V2.Settings.CheckBox}"
                              Content="{localization:LocalisedText ApplicationDialog.MatchActivatedWindow}" />

                    <Grid Margin="0,16,0,0"
                          Visibility="{Binding ElementName=BlockTouchInputSlider, Path=Visibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="BlockTouchInputTextBlock"
                                       Style="{StaticResource V2.Dialog.Label}"
                                       Text="{localization:LocalisedText ApplicationDialog.BlockTouchInput}" />
                            <TextBlock x:Name="BlockTouchInputInfoTextBlock"
                                       Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Style="{StaticResource V2.Text.Caption}" />
                        </Grid>
                        <Slider x:Name="BlockTouchInputSlider"
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Style="{StaticResource V2.Settings.Slider}"
                                common:SliderTools.MoveToPointOnDrag="True"
                                Minimum="1"
                                Maximum="10"
                                SmallChange="1"
                                IsMoveToPointEnabled="True"
                                IsSnapToTickEnabled="True"
                                ValueChanged="BlockTouchInputSlider_ValueChanged" />
                    </Grid>

                    <Grid Margin="0,16,0,0"
                          Visibility="{Binding ElementName=LimitNumberOfFingersSlider, Path=Visibility}">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock x:Name="LimitNumberOfFingersTextBlock"
                                       Style="{StaticResource V2.Dialog.Label}"
                                       Text="{localization:LocalisedText ApplicationDialog.LimitNumberOfFingers}" />
                            <TextBlock x:Name="LimitNumberOfFingersInfoTextBlock"
                                       Grid.Column="1"
                                       Margin="12,0,0,0"
                                       Style="{StaticResource V2.Text.Caption}" />
                        </Grid>
                        <Slider x:Name="LimitNumberOfFingersSlider"
                                Grid.Row="1"
                                Margin="0,8,0,0"
                                Style="{StaticResource V2.Settings.Slider}"
                                common:SliderTools.MoveToPointOnDrag="True"
                                Minimum="1"
                                Maximum="10"
                                SmallChange="1"
                                IsMoveToPointEnabled="True"
                                IsSnapToTickEnabled="True"
                                Value="2"
                                ValueChanged="LimitNumberOfFingersSlider_ValueChanged" />
                    </Grid>
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="1"
                Style="{StaticResource V2.Dialog.Footer}">
            <StackPanel HorizontalAlignment="Right"
                        Orientation="Horizontal">
                <Button x:Name="CancelButton"
                        Width="96"
                        Style="{StaticResource V2.Button.Secondary}"
                        Content="{localization:LocalisedText Common.Cancel}"
                        Click="CancelButton_Click" />
                <Button x:Name="DoneButton"
                        Width="96"
                        Margin="8,0,0,0"
                        Style="{StaticResource V2.Button.Primary}"
                        Content="{localization:LocalisedText Common.Save}"
                        IsDefault="True"
                        Click="DoneButton_Click" />
            </StackPanel>
        </Border>
    </Grid>
</common:TouchWindow>
