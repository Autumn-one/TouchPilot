<Application x:Class="GestureSign.ControlPanel.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Startup="Application_Startup"
             ShutdownMode="OnMainWindowClose"
             Exit="Application_Exit">
    <!--StartupUri="MainWindow.xaml"-->
    <Application.Resources>
        <ResourceDictionary>
            <FlowDirection x:Key="DefaultFlowDirection">LeftToRight</FlowDirection>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Controls.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Fonts.xaml" />
                <ResourceDictionary Source="pack://application:,,,/MahApps.Metro;component/Styles/Themes/Light.Blue.xaml" />
                <ResourceDictionary Source="Themes/V2/Tokens.xaml" />
                <ResourceDictionary Source="Themes/V2/Typography.xaml" />
                <ResourceDictionary Source="Themes/V2/Controls.xaml" />
                <ResourceDictionary Source="Themes/V2/Shell.xaml" />
                <ResourceDictionary Source="Themes/V2/Settings.xaml" />
                <ResourceDictionary Source="Themes/V2/Dialogs.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
