<UserControl x:Class="GestureSign.CorePlugins.OpenFile.OpenFileControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="260"
             d:DesignWidth="350"
             MinWidth="330"
             AllowDrop="True"
             Background="Transparent">
    <StackPanel>
        <TextBlock Style="{StaticResource V2.Dialog.Label}"
                   Text="{localization:LocalisedText CorePlugins.OpenFile.FileOrWebsite}" />
        <TextBox x:Name="PathTextBox"
                 Height="52"
                 Margin="0,6,0,0"
                 Style="{StaticResource V2.Dialog.TextBox}"
                 MaxLines="4"
                 TextWrapping="Wrap"
                 GotKeyboardFocus="TextBox_GotKeyboardFocus"
                 PreviewDragOver="TextBox_PreviewDragOver"
                 PreviewDragEnter="TextBox_PreviewDragOver" />
        <TextBlock Margin="0,12,0,0"
                   Style="{StaticResource V2.Dialog.Label}"
                   Text="{localization:LocalisedText CorePlugins.OpenFile.Arguments}" />
        <TextBox x:Name="ArgumentsTextBox"
                 Height="52"
                 Margin="0,6,0,0"
                 Style="{StaticResource V2.Dialog.TextBox}"
                 MaxLines="4"
                 TextWrapping="Wrap"
                 GotKeyboardFocus="TextBox_GotKeyboardFocus"
                 PreviewDragOver="TextBox_PreviewDragOver"
                 PreviewDragEnter="TextBox_PreviewDragOver" />
        <Grid Margin="0,10,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="104" />
            </Grid.ColumnDefinitions>
            <ComboBox x:Name="VariableComboBox"
                      MinWidth="0"
                      Style="{StaticResource V2.Settings.ComboBox}"
                      Initialized="VariableComboBox_OnInitialized"
                      DropDownClosed="VariableComboBox_DropDownClosed"
                      Focusable="False" />
            <Button x:Name="SelectFileButton"
                    Grid.Column="2"
                    Style="{StaticResource V2.Button.Secondary}"
                    Content="{localization:LocalisedText CorePlugins.OpenFile.Browse}"
                    Click="SelectFileButton_Click" />
        </Grid>
    </StackPanel>
</UserControl>
