<UserControl x:Class="GestureSign.CorePlugins.HotKey.HotKey"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             xmlns:hotKey="clr-namespace:GestureSign.CorePlugins.HotKey"
             mc:Ignorable="d"
             d:DesignHeight="210"
             d:DesignWidth="350"
             MinWidth="330">
    <UserControl.Resources>
        <ObjectDataProvider  ObjectType="{x:Type hotKey:ExtraKeysDescription}"
                             x:Key="ExtraKeys">
        </ObjectDataProvider>
    </UserControl.Resources>
    <Grid PreviewKeyDown="Grid_PreviewKeyDown"
          PreviewKeyUp="Grid_PreviewKeyUp">
        <StackPanel>
            <ComboBox x:Name="ExtraKeysComboBox"
                      MinWidth="0"
                      Style="{StaticResource V2.Settings.ComboBox}"
                      ItemsSource="{Binding Source={StaticResource ExtraKeys}, Path=DescriptionDict}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key"
                      SelectionChanged="ExtraKeysComboBox_SelectionChanged" />
            <TextBlock Margin="0,8,0,0"
                       Style="{StaticResource V2.Text.Caption}"
                       Text="{localization:LocalisedText CorePlugins.HotKey.Tip}"
                       TextWrapping="Wrap" />
            <UniformGrid Margin="0,8,0,0"
                         Columns="4">
                <ToggleButton x:Name="chkWin"
                              Style="{StaticResource V2.Settings.ToggleButton}"
                              Content="Win"
                              Focusable="False" />
                <ToggleButton x:Name="chkControl"
                              Style="{StaticResource V2.Settings.ToggleButton}"
                              Content="Ctrl"
                              Focusable="False" />
                <ToggleButton x:Name="chkShift"
                              Style="{StaticResource V2.Settings.ToggleButton}"
                              Content="Shift"
                              Focusable="False" />
                <ToggleButton x:Name="chkAlt"
                              Style="{StaticResource V2.Settings.ToggleButton}"
                              Content="Alt"
                              Focusable="False" />
            </UniformGrid>
            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="8" />
                    <ColumnDefinition Width="88" />
                </Grid.ColumnDefinitions>
                <TextBox x:Name="txtKey"
                         Height="52"
                         Style="{StaticResource V2.Dialog.TextBox}"
                         InputMethod.IsInputMethodEnabled="False"
                         MaxLines="5"
                         TextWrapping="Wrap">
                    <TextBox.ContextMenu>
                        <ContextMenu Visibility="Collapsed" />
                    </TextBox.ContextMenu>
                </TextBox>
                <Button x:Name="ResetButton"
                        Grid.Column="2"
                        Style="{StaticResource V2.Button.Secondary}"
                        Content="{localization:LocalisedText CorePlugins.HotKey.Reset}"
                        Click="ResetButton_Click" />
            </Grid>
            <CheckBox x:Name="SendByKeybdEventCheckBox"
                      Margin="0,10,0,0"
                      Style="{StaticResource V2.Settings.CheckBox}"
                      Content="{localization:LocalisedText CorePlugins.HotKey.SendByKeybdEvent}" />
        </StackPanel>
    </Grid>
</UserControl>
