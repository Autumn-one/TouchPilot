<UserControl x:Class="GestureSign.CorePlugins.TouchKeyboard.TouchKeyboardUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="240"
             d:DesignWidth="350"
             MinWidth="330">
    <StackPanel>
        <Border Padding="2"
                Background="{StaticResource V2.Brush.SurfaceSubtle}"
                BorderBrush="{StaticResource V2.Brush.Border}"
                BorderThickness="1"
                CornerRadius="{StaticResource V2.Corner.Small}">
            <StackPanel>
                <RadioButton x:Name="AutoRadioButton"
                             Style="{StaticResource V2.Settings.RadioSegment}"
                             Content="{localization:LocalisedText CorePlugins.TouchKeyboard.Auto}"
                             GroupName="0" />
                <RadioButton x:Name="ShowTouchKeyboardRB"
                             Style="{StaticResource V2.Settings.RadioSegment}"
                             Content="{localization:LocalisedText CorePlugins.TouchKeyboard.Show}"
                             GroupName="0" />
                <RadioButton x:Name="HideTouchKeyboardRB"
                             Style="{StaticResource V2.Settings.RadioSegment}"
                             Content="{localization:LocalisedText CorePlugins.TouchKeyboard.Hide}"
                             GroupName="0" />
            </StackPanel>
        </Border>
        <TextBlock Margin="0,10,0,0"
                   Style="{StaticResource V2.Text.Caption}"
                   Text="{localization:LocalisedText CorePlugins.TouchKeyboard.Tip}"
                   TextWrapping="Wrap" />
        <CheckBox x:Name="AutoInvokeCheckBox"
                  Margin="0,10,0,0"
                  Style="{StaticResource V2.Settings.CheckBox}"
                  Content="{localization:LocalisedText CorePlugins.TouchKeyboard.DesktopModeAutoInvoke}"
                  Click="AutoInvokeCheckBox_Click"
                  Loaded="AutoInvokeCheckBox_Loaded" />
    </StackPanel>
</UserControl>

