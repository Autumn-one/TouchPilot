<UserControl x:Class="GestureSign.CorePlugins.LaunchApp.LaunchAppView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="150"
             d:DesignWidth="350"
             MinWidth="330">
    <Grid>
        <StackPanel>
            <TextBlock x:Name="TipTextBlock"
                       Style="{StaticResource V2.Text.Caption}"
                       Text="{localization:LocalisedText CorePlugins.LaunchApp.Loading}"
                       TextWrapping="Wrap" />
            <ComboBox x:Name="comboBox"
                      Height="52"
                      Margin="0,8,0,0"
                      Style="{StaticResource V2.Settings.ComboBox}"
                      HorizontalContentAlignment="Stretch"
                      MaxDropDownHeight="420"
                      Loaded="comboBox_Loaded"
                      Visibility="Hidden">
                <ComboBox.ItemTemplate>
                    <DataTemplate>
                        <Grid MinHeight="40">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="40" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border Width="34"
                                    Height="34"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Background="{Binding BackgroundColor}"
                                    CornerRadius="{StaticResource V2.Corner.Small}">
                                <Image Width="30"
                                       Height="30"
                                       Source="{Binding Logo, TargetNullValue={x:Null}}"
                                       Stretch="Uniform"
                                       StretchDirection="DownOnly" />
                            </Border>
                            <TextBlock Grid.Column="1"
                                       Margin="8,0,0,0"
                                       VerticalAlignment="Center"
                                       Style="{StaticResource V2.Text.Body}"
                                       Text="{Binding AppInfo.Value}"
                                       TextTrimming="CharacterEllipsis"
                                       TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ComboBox.ItemTemplate>
            </ComboBox>
        </StackPanel>
    </Grid>
</UserControl>
