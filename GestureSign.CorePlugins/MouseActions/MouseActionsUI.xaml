<UserControl x:Class="GestureSign.CorePlugins.MouseActions.MouseActionsUI"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:GestureSign.CorePlugins.MouseActions"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="420"
             d:DesignWidth="350"
             MinWidth="330">
    <UserControl.Resources>
        <ObjectDataProvider x:Key="ActionDescription"
                            ObjectType="{x:Type local:MouseActionDescription}" />
        <ObjectDataProvider x:Key="PositionDescription"
                            ObjectType="{x:Type local:ClickPositionDescription}" />
    </UserControl.Resources>
    <StackPanel>
        <TextBlock Style="{StaticResource V2.Dialog.Label}"
                   Text="{localization:LocalisedText CorePlugins.MouseActions.SelectAction}" />
        <ComboBox x:Name="ActionComboBox"
                  Margin="0,6,0,0"
                  Style="{StaticResource V2.Settings.ComboBox}"
                  ItemsSource="{Binding Source={StaticResource ActionDescription}, Path=DescriptionDict}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key"
                  SelectionChanged="ActionComboBox_SelectionChanged" />
        <StackPanel x:Name="ButtonPanel"
                    Margin="0,12,0,0">
            <TextBlock Style="{StaticResource V2.Dialog.Label}"
                       Text="{localization:LocalisedText CorePlugins.MouseActions.Button}" />
            <ComboBox x:Name="MouseButtonComboBox"
                      Margin="0,6,0,0"
                      Style="{StaticResource V2.Settings.ComboBox}"
                      ItemsSource="{Binding Source={StaticResource ActionDescription}, Path=ButtonDescription}"
                      DisplayMemberPath="Value"
                      SelectedValuePath="Key" />
        </StackPanel>
        <TextBlock x:Name="ClickPositionText"
                   Margin="0,12,0,0"
                   Style="{StaticResource V2.Dialog.Label}"
                   Visibility="{Binding ElementName=ButtonPanel,Path=Visibility}"
                   Text="{localization:LocalisedText CorePlugins.MouseActions.ClickPosition}" />
        <ComboBox x:Name="PositionComboBox"
                  Margin="0,6,0,0"
                  Style="{StaticResource V2.Settings.ComboBox}"
                  Visibility="{Binding ElementName=ButtonPanel,Path=Visibility}"
                  SelectionChanged="PositionComboBox_SelectionChanged"
                  ItemsSource="{Binding Source={StaticResource PositionDescription}, Path=DescriptionDict}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key" />
        <TextBlock x:Name="ReferencePositionText"
                   Margin="0,12,0,0"
                   Style="{StaticResource V2.Dialog.Label}"
                   Text="{localization:LocalisedText CorePlugins.MouseActions.ReferencePosition}"
                   TextWrapping="Wrap" />
        <ComboBox x:Name="RelativePositionComboBox"
                  Margin="0,6,0,0"
                  Style="{StaticResource V2.Settings.ComboBox}"
                  Visibility="{Binding ElementName=ReferencePositionText,Path=Visibility}"
                  ItemsSource="{Binding Source={StaticResource PositionDescription}, Path=RelativePositionDict}"
                  DisplayMemberPath="Value"
                  SelectedValuePath="Key" />
        <Grid x:Name="MoveMouseCanvas"
              Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="8" />
                <ColumnDefinition Width="74" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="36" />
            </Grid.ColumnDefinitions>
            <TextBlock VerticalAlignment="Center"
                       Style="{StaticResource V2.Dialog.Label}"
                       Text="X" />
            <TextBox x:Name="XTextBox"
                     Grid.Column="2"
                     Style="{StaticResource V2.Dialog.TextBox}"
                     KeyDown="TextBox_KeyDown"
                     TextChanged="TextBox_TextChanged"
                     TextWrapping="Wrap" />
            <TextBlock Grid.Column="4"
                       VerticalAlignment="Center"
                       Style="{StaticResource V2.Dialog.Label}"
                       Text="Y" />
            <TextBox x:Name="YTextBox"
                     Grid.Column="6"
                     Style="{StaticResource V2.Dialog.TextBox}"
                     KeyDown="TextBox_KeyDown"
                     TextChanged="TextBox_TextChanged"
                     TextWrapping="Wrap" />
            <local:Crosshair x:Name="Crosshair"
                             Grid.Column="8"
                             Width="36"
                             Height="36"
                             CrosshairDragging="Crosshair_CrosshairDragging" />
        </Grid>
        <StackPanel x:Name="ScrollPanel"
                    Margin="0,12,0,0">
            <Border Padding="2"
                    Background="{StaticResource V2.Brush.SurfaceSubtle}"
                    BorderBrush="{StaticResource V2.Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="{StaticResource V2.Corner.Small}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <RadioButton x:Name="PositiveRadioButton"
                                 Style="{StaticResource V2.Settings.RadioSegment}"
                                 GroupName="direction"
                                 IsChecked="True" />
                    <RadioButton x:Name="NegativeRadioButton"
                                 Grid.Column="1"
                                 Style="{StaticResource V2.Settings.RadioSegment}"
                                 GroupName="direction" />
                </Grid>
            </Border>
            <TextBlock Margin="0,12,0,0"
                       Style="{StaticResource V2.Dialog.Label}"
                       Text="{localization:LocalisedText CorePlugins.MouseActions.ScrollAmountTip}" />
            <ComboBox x:Name="ScrollAmountComboBox"
                      Width="120"
                      Margin="0,6,0,0"
                      HorizontalAlignment="Left"
                      Style="{StaticResource V2.Settings.ComboBox}"
                      KeyDown="TextBox_KeyDown"
                      TextBoxBase.TextChanged="TextBox_TextChanged"
                      InputMethod.IsInputMethodEnabled="False"
                      IsEditable="True">
                <ComboBoxItem Content="1" />
                <ComboBoxItem Content="2" />
                <ComboBoxItem Content="3" />
            </ComboBox>
        </StackPanel>
    </StackPanel>
</UserControl>
