<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <RootNamespace>GestureSign.Daemon</RootNamespace>
    <AssemblyName>GestureSign</AssemblyName>
    <ApplicationIcon>Resources\normal.ico</ApplicationIcon>
    <ApplicationManifest Condition="'$(Configuration)' != 'uiAccessRelease'">Properties\app.common.manifest</ApplicationManifest>
    <ApplicationManifest Condition="'$(Configuration)' == 'uiAccessRelease'">Properties\app.uiAccessRelease.manifest</ApplicationManifest>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- The manifest remains the source of truth for normal and uiAccess DPI behavior. -->
    <NoWarn>$(NoWarn);WFO0003</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestureSign.Common\GestureSign.Common.csproj" />
    <ProjectReference Include="..\GestureSign.CorePlugins\GestureSign.CorePlugins.csproj" />
    <ProjectReference Include="..\GestureSign.PointPatterns\GestureSign.PointPatterns.csproj" />
    <ProjectReference Include="..\ManagedWinapi\ManagedWinapi.csproj" />
    <ProjectReference Include="..\WindowsInput\WindowsInput.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Languages\Daemon\en.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
    <None Update="Languages\Daemon\zh.xml">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
    </None>
  </ItemGroup>
</Project>
