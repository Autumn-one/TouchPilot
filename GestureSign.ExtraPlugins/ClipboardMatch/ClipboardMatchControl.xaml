<UserControl x:Class="GestureSign.ExtraPlugins.ClipboardMatch.ClipboardMatchControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:localization="clr-namespace:GestureSign.Common.Localization;assembly=GestureSign.Common"
             mc:Ignorable="d"
             d:DesignHeight="110"
             d:DesignWidth="340"
             MinWidth="300"
             Background="Transparent">
    <StackPanel>
        <TextBlock Style="{StaticResource V2.Dialog.Label}"
                   Text="{localization:LocalisedText ClipboardMatch.PatternString}" />
        <TextBox x:Name="MatchTextBox"
                 Height="44"
                 Margin="0,6,0,0"
                 Style="{StaticResource V2.Dialog.TextBox}"
                 TextWrapping="Wrap"
                 VerticalScrollBarVisibility="Auto"
                 AutomationProperties.Name="{localization:LocalisedText ClipboardMatch.PatternString}" />
    </StackPanel>
</UserControl>
