<UserControl x:Class="GestureSign.ExtraPlugins.TextCopyer.Crosshair"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             mc:Ignorable="d"
             d:DesignHeight="44"
             d:DesignWidth="44">
    <Border Background="{StaticResource V2.Brush.Surface}"
            BorderBrush="{StaticResource V2.Brush.Accent}"
            BorderThickness="1"
            CornerRadius="{StaticResource V2.Corner.Small}">
        <Image x:Name="Dragger"
               Width="30"
               Height="30"
               HorizontalAlignment="Center"
               VerticalAlignment="Center"
               Stretch="Uniform"
               MouseDown="dragger_MouseDown"
               MouseMove="dragger_MouseMove"
               MouseUp="dragger_MouseUp"
               Source="crosshair.ico" />
    </Border>
</UserControl>
