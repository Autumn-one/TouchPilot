<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <RootNamespace>GestureSign.Common</RootNamespace>
    <AssemblyName>GestureSign.Common</AssemblyName>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TouchPilotBuildBuiltAtUtcTicks)' == '' And '$(TouchPilotBuildExpiresAtUtcTicks)' == ''">
    <DefineConstants>$(DefineConstants);TOUCHPILOT_BUILD_LIFETIME_UNRESTRICTED</DefineConstants>
  </PropertyGroup>

  <PropertyGroup Condition="'$(TouchPilotBuildBuiltAtUtcTicks)' != '' And '$(TouchPilotBuildExpiresAtUtcTicks)' != ''">
    <DefineConstants>$(DefineConstants);TOUCHPILOT_BUILD_LIFETIME_ENFORCED</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="NuGet.Versioning" Version="7.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\GestureSign.PointPatterns\GestureSign.PointPatterns.csproj" />
    <ProjectReference Include="..\ManagedWinapi\ManagedWinapi.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Remove="Updates\TouchPilot-update-public.pem" />
    <EmbeddedResource Include="Updates\TouchPilot-update-public.pem"
                      LogicalName="TouchPilot.UpdatePublicKey" />
  </ItemGroup>

  <Target Name="GenerateTouchPilotBuildLifecycleMetadata"
          BeforeTargets="CoreCompile"
          Condition="'$(TouchPilotBuildBuiltAtUtcTicks)' != '' Or '$(TouchPilotBuildExpiresAtUtcTicks)' != ''">
    <Error Condition="'$(TouchPilotBuildBuiltAtUtcTicks)' == '' Or '$(TouchPilotBuildExpiresAtUtcTicks)' == ''"
           Text="TouchPilot build lifecycle metadata requires both build and expiry ticks." />
    <ItemGroup>
      <_TouchPilotBuildLifecycleAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>TouchPilot.BuiltAtUtcTicks</_Parameter1>
        <_Parameter2>$(TouchPilotBuildBuiltAtUtcTicks)</_Parameter2>
      </_TouchPilotBuildLifecycleAttribute>
      <_TouchPilotBuildLifecycleAttribute Include="System.Reflection.AssemblyMetadataAttribute">
        <_Parameter1>TouchPilot.ExpiresAtUtcTicks</_Parameter1>
        <_Parameter2>$(TouchPilotBuildExpiresAtUtcTicks)</_Parameter2>
      </_TouchPilotBuildLifecycleAttribute>
    </ItemGroup>
    <WriteCodeFragment AssemblyAttributes="@(_TouchPilotBuildLifecycleAttribute)"
                       Language="C#"
                       OutputFile="$(IntermediateOutputPath)TouchPilot.BuildLifecycle.g.cs">
      <Output TaskParameter="OutputFile" ItemName="Compile" />
      <Output TaskParameter="OutputFile" ItemName="FileWrites" />
    </WriteCodeFragment>
  </Target>
</Project>
